---
import { MEDIA_BASE_URL } from "../../consts";
import ExcelViewer from "./ExcelViewer.astro";
import MediaGallery from "./MediaGallery.astro";

export interface Props {
  media: string[];
  title?: string;
  labels?: string[];
}

const { media = [], title = "Project Document", labels = [] } = Astro.props;

const isPdf = media.some(item => item.endsWith('.pdf'));
const isExcel = media.some(item => item.endsWith('.xlsx'));
const isVideo = media.some(item => /\.(mov|mp4|webm)$/i.test(item));
const isImage = media.some(item => /\.(webp|jpg|jpeg|png)$/i.test(item));

const getMediaUrl = (itemPath: string) => {
  return `${MEDIA_BASE_URL}/${itemPath}`;
};

const getDocLabel = (itemPath: string, index: number) => {
  if (labels[index]) return labels[index];
  const filename = itemPath.split('/').pop() || '';
  if (filename.includes('all-concrete')) return 'Concrete Members Takeoff';
  if (filename.includes('total-reinforcement')) return 'Reinforcement Price Estimate';
  if (filename.includes('report-waste-water')) return 'EPA SWMM Design Report';
  if (filename.includes('report-2')) return 'Catchment Runoff Summary';
  if (filename.includes('summary')) return 'Executive Summary';
  if (filename.includes('cecg-oel')) return 'BIM & Architectural Report';
  if (filename.includes('cep-water')) return 'Water Treatment Jar Test Report';
  if (filename.includes('comparison-cep-isa')) return 'RISA-2D Analysis Report';
  if (filename.includes('complete-report-rcd')) return 'RC School Structural Report';
  if (filename.includes('dos-cep')) return 'NUST Faisal Masjid Report';
  if (filename.includes('geometric')) return 'Highway Geometric Design Report';
  if (filename.includes('hydology')) return 'Engineering Hydrology Report';
  if (filename.includes('oel-geotech')) return 'Soil Bearing Capacity Report';
  if (filename.includes('poc-cep')) return 'Recycled Aggregate Report';
  if (filename.includes('ppm-report')) return 'Primavera P6 Scheduling Report';
  return `Document ${index + 1}`;
};

// Documents data pointing directly to Cloudflare
const documentsData = isPdf
  ? media.map((docPath, idx) => {
      const url = getMediaUrl(docPath);
      return {
        path: docPath,
        url,
        viewerUrl: `https://docs.google.com/viewer?url=${encodeURIComponent(url)}&embedded=true`,
        label: getDocLabel(docPath, idx),
      };
    })
  : [];

const initialDoc = documentsData[0] || null;
---

{isExcel ? (
  <ExcelViewer media={media} title={title} />
) : isPdf && initialDoc ? (
  <aside class="project-pdf-archive" id="doc-viewer-wrapper" aria-label="Project document preview">
    {documentsData.length > 1 && (
      <nav class="pdf-tabs" aria-label="Select document to preview">
        {documentsData.map((doc, idx) => (
          <button
            type="button"
            class={`pdf-tab ${idx === 0 ? 'is-active' : ''}`}
            data-doc-idx={idx}
            data-viewer-url={doc.viewerUrl}
          >
            <span class="tab-badge">{idx + 1}</span>
            <span class="tab-name">{doc.label}</span>
          </button>
        ))}
      </nav>
    )}

    <div class="doc-viewport" id="doc-viewport">
      <iframe
        id="pdf-embed-frame"
        src={initialDoc.viewerUrl}
        class="pdf-frame"
        title={initialDoc.label}
        loading="lazy"
      ></iframe>
    </div>
  </aside>
) : isVideo ? (
  <aside class="project-video-archive" aria-label="Workplace workflow video capture">
    <div class="video-kicker-bar">
      <div class="kicker-left">
        <span class="video-live-dot" aria-hidden="true"></span>
        <span class="video-kicker">WORKPLACE WORKFLOW CAPTURE</span>
      </div>
      <span class="video-spec-badge">Dual-Screen Workstation</span>
    </div>

    <div class="video-player-container">
      <video
        controls
        playsinline
        preload="metadata"
        class="workflow-video-frame"
      >
        <source src={getMediaUrl(media[0])} type="video/quicktime" />
        <source src={getMediaUrl(media[0])} type="video/mp4" />
        Your browser does not support video playback.
      </video>
    </div>

    <div class="video-caption-bar">
      <p class="video-caption-text">
        Production timelapse recording capturing real-time engineering workflows, model coordination, and operational tasks across dual-monitor workstation.
      </p>
    </div>
  </aside>
) : isImage ? (
  <MediaGallery media={media} title={title} labels={labels} carousel />
) : null}

<script>
  function setupDocumentViewer() {
    const wrapper = document.getElementById('doc-viewer-wrapper');
    if (!wrapper) return;

    const iframe = wrapper.querySelector<HTMLIFrameElement>('#pdf-embed-frame');
    const tabs = wrapper.querySelectorAll<HTMLButtonElement>('.pdf-tab');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');

        const viewerUrl = tab.getAttribute('data-viewer-url');
        if (iframe && viewerUrl) {
          iframe.src = viewerUrl;
        }
      });
    });
  }

  setupDocumentViewer();
  document.addEventListener('astro:page-load', setupDocumentViewer);
</script>

<style>
  .project-pdf-archive {
    background: #141a15;
    border: 1px solid #ffffff1e;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
  }

  .pdf-tabs {
    display: flex;
    background: #101511;
    border-bottom: 1px solid #ffffff14;
    overflow-x: auto;
    padding: 6px 8px;
    gap: 6px;
  }

  .pdf-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    color: #a4aaa0;
    font-size: 12px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .pdf-tab:hover {
    color: #ede8e1;
    background: #ffffff08;
  }

  .pdf-tab.is-active {
    background: #202b21;
    color: #ed8851;
    font-weight: 600;
  }

  .tab-badge {
    font: 10px var(--font-mono);
    width: 18px;
    height: 18px;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: #ffffff14;
  }

  .pdf-tab.is-active .tab-badge {
    background: #ed8851;
    color: #101412;
  }

  .doc-viewport {
    width: 100%;
    height: 720px;
    background: #0d120e;
    position: relative;
  }

  .pdf-frame {
    width: 100%;
    height: 100%;
    border: none;
    background: #111512;
    display: block;
  }

  .project-video-archive {
    background: #141a15;
    border: 1px solid #ffffff1e;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
  }

  .video-kicker-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    background: #18221a;
    border-bottom: 1px solid #ffffff18;
    gap: 12px;
  }

  .kicker-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .video-live-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #ed8851;
    box-shadow: 0 0 8px rgba(237, 136, 81, 0.8);
    animation: livePulse 2s infinite ease-in-out;
  }

  @keyframes livePulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .video-kicker {
    font: 11px/1.4 var(--font-mono);
    color: #ed8851;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .video-spec-badge {
    font: 10px/1 var(--font-mono);
    background: #ffffff14;
    color: #ede8e1;
    padding: 4px 8px;
    border-radius: 3px;
    border: 1px solid #ffffff16;
  }

  .video-player-container {
    width: 100%;
    background: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .workflow-video-frame {
    width: 100%;
    max-height: 580px;
    display: block;
    background: #000000;
    outline: none;
  }

  .video-caption-bar {
    padding: 12px 16px;
    background: #141a15;
    border-top: 1px solid #ffffff14;
  }

  .video-caption-text {
    margin: 0;
    font: 12px/1.5 var(--font-sans);
    color: #a4aaa0;
  }

  @media (max-width: 640px) {
    .doc-viewport {
      height: 500px;
    }
  }
</style>
