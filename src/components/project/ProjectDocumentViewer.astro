---
import { MEDIA_BASE_URL } from "../../consts";
import ExcelViewer from "./ExcelViewer.astro";
import MediaGallery from "./MediaGallery.astro";

export interface Props {
  media: string[];
  title?: string;
  labels?: string[];
}

const { media = [], title = "Project Document", labels = [] } = Astro.props;

const isPdf = media.some(item => item.endsWith('.pdf'));
const isExcel = media.some(item => item.endsWith('.xlsx'));
const isImage = media.some(item => /\.(webp|jpg|jpeg|png)$/i.test(item));

const getMediaUrl = (itemPath: string) => {
  return `${MEDIA_BASE_URL}/${itemPath}`;
};

const getDocLabel = (itemPath: string, index: number) => {
  if (labels[index]) return labels[index];
  const filename = itemPath.split('/').pop() || '';
  if (filename.includes('all-concrete')) return 'Concrete Members Takeoff';
  if (filename.includes('total-reinforcement')) return 'Reinforcement Price Estimate';
  if (filename.includes('report-waste-water')) return 'EPA SWMM Design Report';
  if (filename.includes('report-2')) return 'Catchment Runoff Summary';
  if (filename.includes('summary')) return 'Executive Summary';
  if (filename.includes('cecg-oel')) return 'BIM & Architectural Report';
  if (filename.includes('cep-water')) return 'Water Treatment Jar Test Report';
  if (filename.includes('comparison-cep-isa')) return 'RISA-2D Analysis Report';
  if (filename.includes('complete-report-rcd')) return 'RC School Structural Report';
  if (filename.includes('dos-cep')) return 'NUST Faisal Masjid Report';
  if (filename.includes('geometric')) return 'Highway Geometric Design Report';
  if (filename.includes('hydology')) return 'Engineering Hydrology Report';
  if (filename.includes('oel-geotech')) return 'Soil Bearing Capacity Report';
  if (filename.includes('poc-cep')) return 'Recycled Aggregate Report';
  if (filename.includes('ppm-report')) return 'Primavera P6 Scheduling Report';
  return `Document ${index + 1}`;
};

// Documents data pointing directly to Cloudflare
const documentsData = isPdf
  ? media.map((docPath, idx) => {
      const url = getMediaUrl(docPath);
      return {
        path: docPath,
        url,
        viewerUrl: `https://docs.google.com/viewer?url=${encodeURIComponent(url)}&embedded=true`,
        label: getDocLabel(docPath, idx),
      };
    })
  : [];

const initialDoc = documentsData[0] || null;
---

{isExcel ? (
  <ExcelViewer media={media} title={title} />
) : isPdf && initialDoc ? (
  <aside class="project-pdf-archive" id="doc-viewer-wrapper" aria-label="Official project documents">
    <div class="archive-header">
      <div class="header-left">
        <span class="archive-kicker">OFFICIAL DOCUMENT ARCHIVE</span>
        <span class="file-count" id="active-doc-badge">
          {documentsData.length > 1 ? `1 of ${documentsData.length} Documents` : "PDF Document"}
        </span>
      </div>
      <div class="header-actions">
        <a
          id="pdf-download-btn"
          href={initialDoc.url}
          target="_blank"
          rel="noopener noreferrer"
          class="open-full-btn"
        >
          Open Original PDF ↗
        </a>
      </div>
    </div>

    {documentsData.length > 1 && (
      <nav class="pdf-tabs" aria-label="Select document to preview">
        {documentsData.map((doc, idx) => (
          <button
            type="button"
            class={`pdf-tab ${idx === 0 ? 'is-active' : ''}`}
            data-doc-idx={idx}
            data-doc-url={doc.url}
            data-viewer-url={doc.viewerUrl}
          >
            <span class="tab-badge">{idx + 1}</span>
            <span class="tab-name">{doc.label}</span>
          </button>
        ))}
      </nav>
    )}

    <div class="doc-viewport" id="doc-viewport">
      <iframe
        id="pdf-embed-frame"
        src={initialDoc.viewerUrl}
        class="pdf-frame"
        title={initialDoc.label}
        loading="lazy"
      ></iframe>
    </div>

    <div class="doc-viewer-footer">
      <span class="footer-note">Streamed directly from Cloudflare secure storage</span>
      <a href={initialDoc.url} target="_blank" rel="noopener noreferrer" class="footer-direct-link" id="pdf-footer-link">
        Direct Cloudflare Link ↗
      </a>
    </div>
  </aside>
) : isImage ? (
  <MediaGallery media={media} title={title} labels={labels} carousel />
) : null}

<script>
  function setupDocumentViewer() {
    const wrapper = document.getElementById('doc-viewer-wrapper');
    if (!wrapper) return;

    const iframe = wrapper.querySelector<HTMLIFrameElement>('#pdf-embed-frame');
    const downloadBtn = wrapper.querySelector<HTMLAnchorElement>('#pdf-download-btn');
    const footerLink = wrapper.querySelector<HTMLAnchorElement>('#pdf-footer-link');
    const activeBadge = wrapper.querySelector<HTMLElement>('#active-doc-badge');
    const tabs = wrapper.querySelectorAll<HTMLButtonElement>('.pdf-tab');

    tabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('is-active'));
        tab.classList.add('is-active');

        const viewerUrl = tab.getAttribute('data-viewer-url');
        const docUrl = tab.getAttribute('data-doc-url');

        if (iframe && viewerUrl) {
          iframe.src = viewerUrl;
        }
        if (downloadBtn && docUrl) {
          downloadBtn.href = docUrl;
        }
        if (footerLink && docUrl) {
          footerLink.href = docUrl;
        }
        if (activeBadge) {
          activeBadge.textContent = `${idx + 1} of ${tabs.length} Documents`;
        }
      });
    });
  }

  setupDocumentViewer();
  document.addEventListener('astro:page-load', setupDocumentViewer);
</script>

<style>
  .project-pdf-archive {
    background: #141a15;
    border: 1px solid #ffffff1e;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
    display: flex;
    flex-direction: column;
  }

  .archive-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 18px;
    background: #18221a;
    border-bottom: 1px solid #ffffff18;
    flex-wrap: wrap;
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .archive-kicker {
    font: 11px/1.4 var(--font-mono);
    color: #ed8851;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .file-count {
    font: 11px/1 var(--font-mono);
    background: #ffffff14;
    color: #ede8e1;
    padding: 4px 10px;
    border-radius: 3px;
    border: 1px solid #ffffff16;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .open-full-btn {
    font: 11px/1 var(--font-mono);
    color: #ffffff;
    background: #b54a1a;
    padding: 7px 13px;
    border-radius: 4px;
    text-decoration: none;
    transition: background 0.2s ease;
    white-space: nowrap;
  }

  .open-full-btn:hover {
    background: #e85c1a;
  }

  .pdf-tabs {
    display: flex;
    background: #101511;
    border-bottom: 1px solid #ffffff14;
    overflow-x: auto;
    padding: 5px;
    gap: 5px;
  }

  .pdf-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    border: none;
    color: #a4aaa0;
    font-size: 12px;
    font-weight: 500;
    padding: 8px 14px;
    border-radius: 4px;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .pdf-tab:hover {
    color: #ede8e1;
    background: #ffffff08;
  }

  .pdf-tab.is-active {
    background: #202b21;
    color: #ed8851;
    font-weight: 600;
  }

  .tab-badge {
    font: 10px var(--font-mono);
    width: 18px;
    height: 18px;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: #ffffff14;
  }

  .pdf-tab.is-active .tab-badge {
    background: #ed8851;
    color: #101412;
  }

  .doc-viewport {
    width: 100%;
    height: 680px;
    background: #0d120e;
    position: relative;
  }

  .pdf-frame {
    width: 100%;
    height: 100%;
    border: none;
    background: #111512;
  }

  .doc-viewer-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 16px;
    background: #121813;
    border-top: 1px solid #ffffff14;
    font: 11px/1.4 var(--font-mono);
    color: #7d847a;
    flex-wrap: wrap;
    gap: 8px;
  }

  .footer-direct-link {
    color: #ed8851;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-direct-link:hover {
    color: #ff9e66;
    text-decoration: underline;
  }

  @media (max-width: 640px) {
    .archive-header {
      flex-direction: column;
      align-items: flex-start;
    }
    .doc-viewport {
      height: 480px;
    }
  }
</style>
