    transition: all 0.2s ease;
  }

  .sheet-tab:hover {
    color: #ede8e1;
    border-color: #ffffff30;
  }

  .sheet-tab.is-active {
    background: #107c41;
    color: #ffffff;
    border-color: #107c41;
  }

  .formula-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px;
    background: #161c17;
    border-bottom: 1px solid #ffffff14;
    font: 11px var(--font-mono);
  }

  .formula-fx {
    color: #107c41;
    font-weight: 700;
    font-style: italic;
  }

  .formula-text {
    color: #c9d0c5;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sheet-panels {
    max-height: 480px;
    overflow-y: auto;
    background: #111512;
  }

  .sheet-panel {
    display: none;
  }

  .sheet-panel.is-active {
    display: block;
  }

  .table-scroll {
    overflow-x: auto;
  }

  .excel-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
    color: #d8ded4;
  }

  .excel-table th,
  .excel-table td {
    padding: 9px 12px;
    border: 1px solid #ffffff10;
    text-align: left;
    white-space: nowrap;
  }

  .excel-table th {
    background: #19221a;
    font: 10px/1 var(--font-mono);
    letter-spacing: 0.05em;
    color: #9ba197;
  }

  .excel-table th.row-num,
  .excel-table td.row-num {
    width: 38px;
    text-align: center;
    background: #151b16;
    color: #6c7368;
    font-family: var(--font-mono);
    font-size: 10px;
    border-right: 1px solid #ffffff1c;
  }

  .section-row td {
    background: #1a241b;
    color: #e5976b;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 10px 12px;
  }

  .check-row {
