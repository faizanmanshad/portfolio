---
/**
 * Nav.astro — Compact fixed navigation
 * Editorial Engineer × Spatial Blueprint
 *
 * Left:       FM. logotype
 * Center/Right: primary section links
 * Far right:  EXPLORE · INDEX mode switch
 */

interface Props {
  currentPath?: string;
  mode?: 'explore' | 'index';
}

const { currentPath = '/', mode = 'explore' } = Astro.props;

const isExplore = mode === 'explore' || currentPath === '/';
const isIndex   = currentPath.startsWith('/academic');

const navLinks = [
  { label: 'Work',        href: '/work/' },
  { label: 'Projects',    href: '/projects/' },
  { label: 'Research',    href: '/research/' },
  { label: 'Recognition', href: '/recognition/' },
  { label: 'About',       href: '/about/' },
];
---

<nav
  class="site-nav"
  data-mode={mode}
  aria-label="Primary navigation"
>
  <!-- Logotype -->
  <a href="/" class="nav-logo" aria-label="Faizan Manshad — home">
    FM<span class="nav-logo-dot accent">.</span>
  </a>

  <!-- Primary links — hidden on small screens, visible on md+ -->
  <ul class="nav-links" role="list">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class:list={['nav-link', { 'nav-link--active': currentPath.startsWith(link.href) }]}
          aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>

  <!-- Mobile nav toggle -->
  <button
    class="nav-mobile-btn"
    aria-label="Toggle navigation menu"
    aria-expanded="false"
    aria-controls="nav-mobile-menu"
    id="nav-toggle"
  >
    <span class="nav-mobile-icon" aria-hidden="true">
      <span></span><span></span>
    </span>
  </button>

  <!-- Explore / Index toggle -->
  <div class="nav-mode-switch" role="group" aria-label="View mode">
    <a
      href="/"
      class:list={['mode-btn', { 'mode-btn--active': isExplore }]}
      aria-label="Explore mode"
      id="mode-explore"
    >
      EXPLORE
    </a>
    <span class="mode-divider" aria-hidden="true">·</span>
    <a
      href="/academic/"
      class:list={['mode-btn', { 'mode-btn--active': isIndex }]}
      aria-label="Index mode"
      id="mode-index"
    >
      ACADEMIC
    </a>
  </div>
</nav>

<!-- Mobile overlay menu -->
<div class="nav-mobile-menu" id="nav-mobile-menu" aria-hidden="true">
  <ul role="list">
    {navLinks.map(link => (
      <li>
        <a
          href={link.href}
          class:list={['nav-mobile-link', { 'nav-mobile-link--active': currentPath.startsWith(link.href) }]}
        >
          {link.label}
        </a>
      </li>
    ))}
    <li class="mobile-mode-row">
      <a href="/" class:list={['nav-mobile-link mode-mobile', { 'mode-mobile--active': isExplore }]}>
        EXPLORE
      </a>
      <span aria-hidden="true">·</span>
      <a href="/academic/" class:list={['nav-mobile-link mode-mobile', { 'mode-mobile--active': isIndex }]}>
        ACADEMIC
      </a>
    </li>
  </ul>
</div>

<script>
  // Scroll detection — adds backdrop when scrolled
  const nav = document.querySelector('.site-nav') as HTMLElement | null;
  if (nav) {
    const onScroll = () => {
      nav.dataset.scrolled = window.scrollY > 20 ? 'true' : 'false';
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Mobile toggle
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('nav-mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      menu.setAttribute('aria-hidden', String(isOpen));
      menu.classList.toggle('nav-mobile-menu--open', !isOpen);
      document.body.style.overflow = isOpen ? '' : 'hidden';
    });

    // Close on link click
    menu.querySelectorAll('a').forEach(a => {
      a.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        menu.setAttribute('aria-hidden', 'true');
        menu.classList.remove('nav-mobile-menu--open');
        document.body.style.overflow = '';
      });
    });
  }
</script>

<style>
  /* ── Nav shell ─────────────────────────────────────────── */
  .site-nav {
    position:        fixed;
    top:             0;
    left:            0;
    right:           0;
    z-index:         var(--z-nav);
    height:          var(--nav-h);
    display:         flex;
    align-items:     center;
    padding:         0 var(--s-8);
    gap:             var(--s-8);

    /* Default: transparent, transitions on scroll */
    background:      transparent;
    border-bottom:   1px solid transparent;
    transition:
      background var(--t-ui) var(--ease-out),
      border-color var(--t-ui) var(--ease-out);
  }

  /* Scrolled state — subtle backdrop */
  .site-nav[data-scrolled="true"] {
    background:   rgba(16, 18, 20, 0.88);
    border-color: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .site-nav[data-mode="index"][data-scrolled="true"] {
    background:   rgba(245, 241, 236, 0.9);
    border-color: rgba(0, 0, 0, 0.08);
  }

  /* ── Logotype ──────────────────────────────────────────── */
  .nav-logo {
    font-family:    var(--font-sans);
    font-weight:    600;
    font-size:      1.0625rem;
    letter-spacing: var(--tracking-tight);
    color:          var(--c-explore-text);
    flex-shrink:    0;
    transition:     color var(--t-micro) var(--ease-out);
    line-height:    1;
  }

  .site-nav[data-mode="index"] .nav-logo {
    color: var(--c-index-text);
  }

  .nav-logo:hover,
  .nav-logo:focus-visible {
    color: inherit;
    opacity: 0.7;
  }

  .nav-logo-dot {
    /* accent dot — inherits .accent utility */
  }

  /* ── Primary links ─────────────────────────────────────── */
  .nav-links {
    display:         flex;
    list-style:      none;
    margin:          0;
    padding:         0;
    gap:             var(--s-6);
    flex:            1;
    /* Push links toward center-right */
    justify-content: flex-end;
  }

  .nav-link {
    font-size:      var(--text-sm);
    font-weight:    400;
    letter-spacing: 0.01em;
    color:          var(--c-explore-muted);
    transition:     color var(--t-micro) var(--ease-out);
    position:       relative;
  }

  .site-nav[data-mode="index"] .nav-link {
    color: var(--c-index-muted);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--c-text);
  }

  .site-nav[data-mode="index"] .nav-link:hover,
  .site-nav[data-mode="index"] .nav-link:focus-visible {
    color: var(--c-index-text);
  }

  .nav-link--active {
    color: var(--c-text) !important;
  }

  .site-nav[data-mode="index"] .nav-link--active {
    color: var(--c-index-text) !important;
  }

  /* ── Mode switch ───────────────────────────────────────── */
  .nav-mode-switch {
    display:     flex;
    align-items: center;
    gap:         var(--s-2);
    flex-shrink: 0;
    margin-left: var(--s-4);
  }

  .mode-divider {
    font-family: var(--font-mono);
    font-size:   var(--text-xs);
    color:       var(--c-explore-muted);
    user-select: none;
    line-height: 1;
  }

  .site-nav[data-mode="index"] .mode-divider {
    color: var(--c-index-muted);
  }

  .mode-btn {
    font-family:    var(--font-mono);
    font-size:      var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color:          var(--c-explore-muted);
    transition:     color var(--t-micro) var(--ease-out);
    padding:        var(--s-1) 0;
    position:       relative;
    line-height:    1;
  }

  .site-nav[data-mode="index"] .mode-btn {
    color: var(--c-index-muted);
  }

  .mode-btn--active {
    color: var(--c-accent) !important;
  }

  /* Subtle underline on active mode */
  .mode-btn--active::after {
    content:    '';
    position:   absolute;
    bottom:     -2px;
    left:       0;
    right:      0;
    height:     1px;
    background: var(--c-accent);
  }

  .mode-btn:hover:not(.mode-btn--active),
  .mode-btn:focus-visible:not(.mode-btn--active) {
    color: var(--c-text);
  }

  .site-nav[data-mode="index"] .mode-btn:hover:not(.mode-btn--active),
  .site-nav[data-mode="index"] .mode-btn:focus-visible:not(.mode-btn--active) {
    color: var(--c-index-text);
  }

  /* ── Mobile button ─────────────────────────────────────── */
  .nav-mobile-btn {
    display:    none;
    background: none;
    border:     none;
    cursor:     pointer;
    padding:    var(--s-2);
    color:      var(--c-text);
    margin-left: auto;
  }

  .site-nav[data-mode="index"] .nav-mobile-btn {
    color: var(--c-index-text);
  }

  .nav-mobile-icon {
    display:        flex;
    flex-direction: column;
    gap:            5px;
    width:          20px;
  }

  .nav-mobile-icon span {
    display:      block;
    height:       1px;
    background:   currentColor;
    transition:   transform var(--t-micro) var(--ease-out),
                  opacity   var(--t-micro) var(--ease-out);
  }

  /* ── Mobile menu ───────────────────────────────────────── */
  .nav-mobile-menu {
    display:    none;
    position:   fixed;
    inset:      0;
    z-index:    calc(var(--z-nav) - 1);
    background: var(--c-bg);
    padding:    calc(var(--nav-h) + var(--s-8)) var(--s-6) var(--s-8);
    overflow-y: auto;
  }

  .nav-mobile-menu ul {
    list-style: none;
    margin:     0;
    padding:    0;
  }

  .nav-mobile-link {
    display:        block;
    font-size:      var(--text-xl);
    font-weight:    400;
    letter-spacing: var(--tracking-tight);
    color:          var(--c-explore-muted);
    padding:        var(--s-4) 0;
    border-bottom:  1px solid var(--c-border);
    transition:     color var(--t-micro) var(--ease-out);
  }

  .nav-mobile-link--active,
  .nav-mobile-link:hover {
    color: var(--c-text);
  }

  .mobile-mode-row {
    display:     flex;
    align-items: center;
    gap:         var(--s-3);
    padding:     var(--s-6) 0 0;
    margin-top:  var(--s-4);
  }

  .mode-mobile {
    font-family:    var(--font-mono);
    font-size:      var(--text-sm);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color:          var(--c-explore-muted);
    padding:        0;
    border:         none;
    display:        inline;
  }

  .mode-mobile--active {
    color: var(--c-accent) !important;
  }

  /* ── Responsive ────────────────────────────────────────── */
  @media (max-width: 900px) {
    .nav-links {
      display: none;
    }

    .nav-mobile-btn {
      display: flex;
    }

    .nav-mode-switch {
      margin-left: var(--s-2);
    }
  }

  @media (max-width: 480px) {
    .site-nav {
      padding: 0 var(--s-4);
      gap:     var(--s-4);
    }
  }

  /* Mobile menu open state */
  .nav-mobile-menu--open {
    display: block;
  }
</style>
