---
export interface Props {
  id: string;
  title: string;
  subtitle: string;
}
const { id, title, subtitle } = Astro.props;
---
<section id={id} class="explore-chapter container">
  <header class="chapter-header">
    <p class="chapter-subtitle label mono">{subtitle}</p>
    <h2 class="chapter-title">{title}</h2>
  </header>
  <div class="chapter-content">
    <slot />
  </div>
</section>

<style>
  .explore-chapter {
    position: relative;
    min-height: 100vh;
    padding-top: var(--s-32);
    padding-bottom: var(--s-32);
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 10;
    /* Ensure dark background covers the portal when scrolling past it */
    background-color: var(--c-bg); 
  }

  .chapter-header {
    margin-bottom: var(--s-24);
    will-change: transform, opacity;
  }

  .chapter-subtitle {
    color: var(--c-accent);
    margin-bottom: var(--s-4);
    letter-spacing: var(--tracking-widest);
  }

  .chapter-title {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    margin: 0;
  }

  .chapter-content {
    position: relative;
    width: 100%;
  }

  /* Microinteractions for spatial grid items inside this chapter */
  :global(.project-field) {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--s-8);
    width: 100%;
  }

  :global(.spatial-project) {
    position: relative;
    border: 1px solid var(--c-explore-border);
    padding: var(--s-8);
    transition: background 0.3s ease, border-color 0.3s ease;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  :global(.spatial-project:hover) {
    background: rgba(255, 255, 255, 0.03);
    border-color: var(--c-accent);
  }

  :global(.spatial-project .project-meta) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-size: var(--text-sm);
    color: var(--c-muted);
    opacity: 0.6;
    transition: opacity 0.3s ease;
  }

  :global(.spatial-project:hover .project-meta) {
    opacity: 1;
  }

  :global(.spatial-project h3) {
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
    transform: translateY(10px);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), color 0.4s ease;
  }

  :global(.spatial-project:hover h3) {
    transform: translateY(0);
    color: var(--c-accent);
  }
  
  :global(.spatial-project .hover-line) {
    position: absolute;
    bottom: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background-color: var(--c-accent);
    transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(.spatial-project:hover .hover-line) {
    width: 100%;
  }

  @media (max-width: 768px) {
    :global(.project-field) {
      display: flex;
      flex-direction: column;
      gap: var(--s-8);
    }
    :global(.spatial-project) {
      aspect-ratio: auto;
      min-height: 30vh;
    }
  }
</style>
