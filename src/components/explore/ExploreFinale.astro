---
// src/components/explore/ExploreFinale.astro
---
<section class="explore-finale">
  <div class="finale-sticky">
    <div class="finale-bg">
      {/* Constellation nodes representing the journey */}
      {Array.from({ length: 50 }).map((_, i) => {
         const size = Math.random() * 3 + 1;
         const x = Math.random() * 100;
         const y = Math.random() * 100;
         const delay = Math.random() * -20;
         return (
           <div 
             class="constellation-node" 
             style={`width: ${size}px; height: ${size}px; left: ${x}%; top: ${y}%; animation-delay: ${delay}s;`}
           ></div>
         )
      })}
    </div>
    
    <div class="finale-content">
      <h2 class="finale-statement gsap-finale-text">
        BUILDING ACROSS <br/>
        <span class="accent-text">PHYSICAL + DIGITAL</span> <br/>
        SYSTEMS
      </h2>
      
      <div class="finale-links gsap-finale-links">
        <a href="/portfolio/index/" class="cta-link interactive magnetic">VIEW ARCHIVE INDEX</a>
        <a href="/portfolio/academic/" class="cta-link interactive magnetic">VIEW ACADEMIC CV</a>
        <a href="mailto:faizan@example.com" class="cta-link interactive magnetic">CONTACT ME</a>
      </div>
    </div>
  </div>
</section>

<style>
  .explore-finale {
    position: relative;
    height: 200vh; /* Allow scroll timeline for the finale */
    background-color: var(--c-bg);
    z-index: 20;
  }

  .finale-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    overflow: hidden;
  }

  .finale-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.3;
  }

  .constellation-node {
    position: absolute;
    background-color: var(--c-accent);
    border-radius: 50%;
    opacity: 0;
    animation: pulse 4s ease-in-out infinite alternate;
  }

  @keyframes pulse {
    0% { opacity: 0; transform: scale(0.5); }
    100% { opacity: 0.8; transform: scale(1.5); }
  }

  .finale-content {
    position: relative;
    z-index: 2;
    text-align: center;
    width: 100%;
    padding: 0 var(--s-8);
  }

  .finale-statement {
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    margin-bottom: var(--s-16);
    text-transform: uppercase;
  }

  .accent-text {
    color: var(--c-accent);
  }

  .finale-links {
    display: flex;
    gap: var(--s-8);
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-link {
    font-family: var(--font-mono);
    font-size: var(--text-base);
    letter-spacing: var(--tracking-label);
    border-bottom: 1px solid currentColor;
    padding-bottom: 4px;
    text-decoration: none;
    color: inherit;
    transition: color 0.3s ease;
  }
  
  .cta-link:hover {
    color: var(--c-accent);
  }

  @media (max-width: 768px) {
    .finale-links {
      flex-direction: column;
      gap: var(--s-4);
      align-items: center;
    }
  }
</style>
