---
/**
 * Layout.astro — Global page shell
 * Editorial Engineer × Spatial Blueprint × Digital Model
 */
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Cursor from "../components/Cursor.astro";
import ContextReturn from "../components/ContextReturn.astro";
import "@fontsource-variable/instrument-sans";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import { SITE_METADATA } from "../consts";

interface Props {
  title?: string;
  description?: string;
  mode?: "explore" | "index";
}

const {
  title = SITE_METADATA.default.title,
  description = SITE_METADATA.default.description,
  mode = "explore",
} = Astro.props;

const currentPath = Astro.url.pathname;

// Derive mode from path if not explicitly set
const resolvedMode: "explore" | "index" =
  currentPath === "/"
    ? "explore"
    : currentPath.startsWith("/academic")
      ? "index"
      : mode;
---

<!doctype html>
<html lang="en" data-mode={resolvedMode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={Astro.url.href} />

    <!--
      Fonts: Instrument Sans (variable, primary) + IBM Plex Mono (metadata)
      Preconnect for performance, variable font axes: wdth + wght
    -->
    
    <script is:inline>
      (function () {
        var path = window.location.pathname;
        if (path === "/" || path === "/index.html") {
          sessionStorage.setItem("portfolioMode", "explore");
        } else if (path.startsWith("/academic")) {
          sessionStorage.setItem("portfolioMode", "academic");
        }
        var mode = sessionStorage.getItem("portfolioMode") || "explore";
        document.documentElement.setAttribute("data-active-mode", mode);
        
        // Check if this is an internal navigation or a reload
        const navType = performance.getEntriesByType('navigation')[0]?.type;
        const isReload = navType === 'reload';
        const isInternal = document.referrer.startsWith(window.location.origin);
        const isHomePage = path === '/' || path === '/index.html';
        
        // Always replay the 3D intro if user reloads or directly visits the home page
        if (isHomePage && (isReload || !isInternal)) {
          sessionStorage.removeItem('skipIntro');
        }
        // If they landed directly on a sub-page (not from our site), skip the intro for nav clarity
        if (!isInternal && !isHomePage) {
          sessionStorage.setItem('skipIntro', 'true');
        }
      })();
    </script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-2BJZCTDVTF"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-2BJZCTDVTF');
    </script>
  </head>

  <body data-mode={resolvedMode}>
    <script is:inline>
      (function() {
        var path = window.location.pathname;
        var isHomePage = path === '/' || path === '/index.html';
        var skipIntro = sessionStorage.getItem('skipIntro') === 'true';
        if (!isHomePage || (isHomePage && skipIntro)) {
          var baseStyle = 'position:fixed;top:0;bottom:0;z-index:2147483647;pointer-events:none;will-change:transform;';
          var left = document.createElement('div');
          left.id = 'pre-door-left';
          left.style.cssText = baseStyle + 'left:0;width:50vw;background:linear-gradient(to right, #101412 70%, #2a1008 100%);';
          var right = document.createElement('div');
          right.id = 'pre-door-right';
          right.style.cssText = baseStyle + 'right:0;width:50vw;background:linear-gradient(to left, #101412 70%, #2a1008 100%);';
          document.body.appendChild(left);
          document.body.appendChild(right);
          // Never leave content covered if the animation bundle fails to load.
          setTimeout(function () { left.remove(); right.remove(); }, 3000);
        }
      })();
    </script>
    <!-- Skip to main content (accessibility) -->
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>

    <!-- Custom Cursor -->
    <Cursor />

    <!-- Compact fixed navigation -->
    <Nav currentPath={currentPath} mode={resolvedMode} />

    <!-- Content remains readable while the optional transition initializes. -->
    <div id="main-content" tabindex="-1">
      <slot />
      <ContextReturn />
    </div>

    <script>
      import "../scripts/pageMotion";
    </script>
  </body>
</html>
