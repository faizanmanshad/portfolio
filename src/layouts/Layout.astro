---
/**
 * Layout.astro — Global page shell
 * Editorial Engineer × Spatial Blueprint × Digital Model
 */
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Cursor from "../components/Cursor.astro";
import ContextReturn from "../components/ContextReturn.astro";

interface Props {
  title?: string;
  description?: string;
  mode?: "explore" | "index";
}

const {
  title = "Faizan Manshad",
  description = "Civil engineer, BIM specialist and digital construction researcher. Working across physical structures, digital models, and emerging construction technology.",
  mode = "explore",
} = Astro.props;

const currentPath = Astro.url.pathname;

// Derive mode from path if not explicitly set
const resolvedMode: "explore" | "index" =
  currentPath === "/"
    ? "explore"
    : currentPath.startsWith("/academic")
      ? "index"
      : mode;
---

<!doctype html>
<html lang="en" data-mode={resolvedMode}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={Astro.url.href} />

    <!--
      Fonts: Instrument Sans (variable, primary) + IBM Plex Mono (metadata)
      Preconnect for performance, variable font axes: wdth + wght
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wdth,wght@0,75..100,400..600;1,75..100,400..600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (function () {
        var path = window.location.pathname;
        if (path === "/" || path === "/index.html") {
          sessionStorage.setItem("portfolioMode", "explore");
        } else if (path.startsWith("/academic")) {
          sessionStorage.setItem("portfolioMode", "academic");
        }
        var mode = sessionStorage.getItem("portfolioMode") || "explore";
        document.documentElement.setAttribute("data-active-mode", mode);
        
        // Check if this is an internal navigation or a reload
        const navType = performance.getEntriesByType('navigation')[0]?.type;
        const isReload = navType === 'reload';
        const isInternal = document.referrer.startsWith(window.location.origin);
        const isHomePage = path === '/' || path === '/index.html';
        
        // Always replay the 3D intro if user reloads or directly visits the home page
        if (isHomePage && (isReload || !isInternal)) {
          sessionStorage.removeItem('skipIntro');
        }
        // If they landed directly on a sub-page (not from our site), skip the intro for nav clarity
        if (!isInternal && !isHomePage) {
          sessionStorage.setItem('skipIntro', 'true');
        }
      })();
    </script>
  </head>

  <body data-mode={resolvedMode}>
    <script is:inline>
      (function() {
        var path = window.location.pathname;
        var isHomePage = path === '/' || path === '/index.html';
        var skipIntro = sessionStorage.getItem('skipIntro') === 'true';
        if (!isHomePage || (isHomePage && skipIntro)) {
          var baseStyle = 'position:fixed;top:0;bottom:0;z-index:2147483647;pointer-events:none;';
          var left = document.createElement('div');
          left.id = 'pre-door-left';
          left.style.cssText = baseStyle + 'left:0;width:50vw;background:linear-gradient(to right, #101412 70%, #2a1008 100%);';
          var right = document.createElement('div');
          right.id = 'pre-door-right';
          right.style.cssText = baseStyle + 'right:0;width:50vw;background:linear-gradient(to left, #101412 70%, #2a1008 100%);';
          document.body.appendChild(left);
          document.body.appendChild(right);
        }
      })();
    </script>
    <!-- Skip to main content (accessibility) -->
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>

    <!-- Custom Cursor -->
    <Cursor />

    <!-- Compact fixed navigation -->
    <Nav currentPath={currentPath} mode={resolvedMode} />

    <!-- Page content (Hidden initially, revealed after Iris wipe) -->
    <div id="main-content" tabindex="-1" style="opacity: 0;">
      <slot />
      <ContextReturn />
    </div>

    <!-- Initialize Lenis and GSAP globally -->
    <script>
      import Lenis from "lenis";
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // Initialize Lenis
      const lenis = new Lenis({
        duration: 1.2,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // easeOutExpo
        orientation: "vertical",
        gestureOrientation: "vertical",
        smoothWheel: true,
        wheelMultiplier: 1,
        infinite: false,
      });

      // Sync Lenis with GSAP ScrollTrigger
      lenis.on("scroll", ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);
      
      // Global Scroll Reveal Animations
      const revealElements = document.querySelectorAll(
        '.practice-card, .principle-grid > div, .register-row, .research-copy, .section-heading, .studio-footer > div, .index-row, .index-title, .index-deck, .cv-index-list > li'
      );
      
      const isExplorePage = window.location.pathname === '/' || window.location.pathname === '/index.html';
      
      // Initially hide elements to prevent flicker during transition
      revealElements.forEach((el) => {
        if (isExplorePage) {
          gsap.set(el, { y: 40, opacity: 0 });
        } else {
          // Academic / Subpages: only hide elements below the fold so top text is instantly ready when doors open
          const rect = el.getBoundingClientRect();
          if (rect.top > window.innerHeight * 0.8) {
            gsap.set(el, { y: 40, skewY: 5, opacity: 0 });
          }
        }
      });
      
      function initScrollReveals() {
        // First fade in the main content container
        gsap.to('#main-content', { 
          opacity: 1, 
          duration: 0.8, 
          ease: "power2.out",
          onComplete: () => {
            // Then trigger the scroll reveals for individual elements
            revealElements.forEach((el) => {
              if (isExplorePage) {
                gsap.to(el, { 
                  y: 0, 
                  opacity: 1, 
                  duration: 1.2, // smoother
                  ease: "power3.out",
                  scrollTrigger: {
                    trigger: el,
                    start: "top 95%",
                    toggleActions: "play none none reverse"
                  }
                });
              } else {
                gsap.to(el, { 
                  y: 0, 
                  skewY: 0,
                  opacity: 1, 
                  duration: 1.0, 
                  ease: "power3.out",
                  clearProps: "transform",
                  scrollTrigger: {
                    trigger: el,
                    start: "top 95%",
                    toggleActions: "play none none reverse"
                  }
                });
              }
            });
          }
        });
      }

      // Global Custom Cursor Logic
      const cursor = document.getElementById("custom-cursor");
      const hasHover = window.matchMedia('(hover: hover)').matches;
      if (cursor && hasHover) {
        // Show cursor when mouse moves
        document.addEventListener(
          "mousemove",
          () => {
            cursor.style.opacity = "1";
          },
          { once: true },
        );

        // Update cursor position using GSAP for smooth trailing
        let mouseX = 0,
          mouseY = 0;
        let cursorX = 0,
          cursorY = 0;

        document.addEventListener("mousemove", (e) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
        });

        // Use GSAP ticker to smoothly interpolate cursor position
        gsap.ticker.add(() => {
          // Lerp for smooth trailing effect
          cursorX += (mouseX - cursorX) * 0.15;
          cursorY += (mouseY - cursorY) * 0.15;
          gsap.set(cursor, { x: cursorX, y: cursorY });
        });

        // Handle hover states on interactive elements and Magnetic effect
        const interactiveElements = document.querySelectorAll(
          "a, button, .interactive",
        );
        interactiveElements.forEach((el) => {
          el.addEventListener("mouseenter", () => {
            gsap.to(cursor, { scale: 3, duration: 0.3, ease: "power2.out" });
          });
          el.addEventListener("mouseleave", () => {
            gsap.to(cursor, { scale: 1, duration: 0.3, ease: "power2.out" });
            gsap.to(el, { x: 0, y: 0, duration: 0.5, ease: "power2.out" });
          });

          // Magnetic effect
          el.addEventListener("mousemove", (e: any) => {
            const rect = el.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            // Only apply magnetic effect if it's a specific class or we can just apply a small movement
            if (el.classList.contains("magnetic")) {
              gsap.to(el, {
                x: x * 0.3,
                y: y * 0.3,
                duration: 0.3,
                ease: "power2.out",
              });
            }
          });
        });
      }

      // Helper: create a split-door transition pair with orange accent gradient
      function createDoorPanels() {
        const baseStyle = 'position:fixed;top:0;bottom:0;z-index:2147483647;pointer-events:none;';
        const left = document.createElement('div');
        left.style.cssText = baseStyle + 'left:0;width:0;background:linear-gradient(to right, #101412 70%, #2a1008 100%);';
        const right = document.createElement('div');
        right.style.cssText = baseStyle + 'right:0;width:0;background:linear-gradient(to left, #101412 70%, #2a1008 100%);';
        document.body.appendChild(left);
        document.body.appendChild(right);
        return { left, right };
      }

      // Door Close: panels slide in from edges to meet in center
      function doorClose(onComplete: (panels: { left: HTMLElement, right: HTMLElement }) => void) {
        const panels = createDoorPanels();
        gsap.to([panels.left, panels.right], {
          width: '50vw',
          duration: 0.85,
          ease: 'power4.inOut',
          onComplete: () => onComplete(panels)
        });
      }

      // Door Open: panels slide back out to edges
      function doorOpen(existingPanels?: { left: HTMLElement, right: HTMLElement }, onComplete?: () => void) {
        let panels = existingPanels;
        if (!panels) {
          let left = document.getElementById('pre-door-left') as HTMLElement;
          let right = document.getElementById('pre-door-right') as HTMLElement;
          
          if (!left || !right) {
            const baseStyle = 'position:fixed;top:0;bottom:0;z-index:2147483647;pointer-events:none;';
            left = document.createElement('div');
            left.style.cssText = baseStyle + 'left:0;width:50vw;background:linear-gradient(to right, #101412 70%, #2a1008 100%);';
            right = document.createElement('div');
            right.style.cssText = baseStyle + 'right:0;width:50vw;background:linear-gradient(to left, #101412 70%, #2a1008 100%);';
            document.body.appendChild(left);
            document.body.appendChild(right);
          }
          panels = { left, right };
        }
        
        gsap.to([panels.left, panels.right], {
          width: 0,
          duration: 0.85,
          ease: 'power4.inOut',
          onComplete: () => { 
            panels!.left.remove(); 
            panels!.right.remove(); 
            if (onComplete) onComplete(); 
          }
        });
      }

      // Page Navigation: close doors, then navigate
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement).closest('a');
        if (link && link.href && link.hostname === window.location.hostname && link.target !== '_blank') {
          const currentUrl = new URL(window.location.href);
          const targetUrl = new URL(link.href);
          if (currentUrl.pathname === targetUrl.pathname && targetUrl.hash) return;
          e.preventDefault();
          doorClose(() => { window.location.href = link.href; });
        }
      });

      // Page Load: decide which reveal to use
      const currentPath = window.location.pathname;
      const isHomePage = currentPath === '/' || currentPath === '/index.html';
      const skipIntro = sessionStorage.getItem('skipIntro') === 'true';

      if (!isHomePage) {
          // All sub-pages: doors start closed on new page, then open
          setTimeout(() => {
              doorOpen();
              initScrollReveals();
          }, 50);
      } else if (isHomePage && skipIntro) {
          // Returning visitor to home page
          // Give WebGL/Canvas time to compile shaders before animating doors to avoid stutter
          setTimeout(() => {
              doorOpen();
              initScrollReveals();
          }, 350);
      } else {
          // First-ever visit to home page: 3D model handles the intro sequence
          gsap.to('#main-content', { opacity: 1, duration: 0.1 });
          initScrollReveals();
      }
    </script>
  </body>
</html>
