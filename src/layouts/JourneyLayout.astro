---
import type { CollectionEntry } from "astro:content";
import Layout from "./Layout.astro";
import MediaGallery from "../components/project/MediaGallery.astro";

interface Props {
  entry: CollectionEntry<"journey"> | CollectionEntry<"development">;
}

const { entry } = Astro.props;

const labels = (entry.data.media || []).map((path) => "Certificate / Document");
---

<Layout
  title={`${entry.data.title} | Faizan Manshad`}
  description={entry.data.summary}
>
  <main class="journey-page container">
    <a class="archive" href={entry.collection === "development" ? "/academic/#certifications" : "/academic/#journey"}>
      {entry.collection === "development" ? "Certifications & Training" : "Journey"} / Academic archive ↗
    </a>
    <div class="journey-grid">
      <section>
        <p class="eyebrow">
          DOMAIN <span> / {entry.data.dateDisplay}</span>
        </p>
        <h1>{entry.data.title}</h1>
        {entry.data.type && <p class="institution">{entry.data.type}</p>}
        {entry.data.domains && entry.data.domains.length > 0 && entry.data.domains.join(", ") !== entry.data.type && (
          <p class="location">{entry.data.domains.join(", ")}</p>
        )}
        <p class="intro">{entry.data.summary}</p>
        <div class="journey-details">
          <slot />
        </div>
      </section>
      
      {entry.data.media && entry.data.media.length > 0 && (
        <aside class="documents" aria-label="Journey documents">
          <div class="document-heading">
            <span>DOCUMENT ARCHIVE</span>
            <span>Click to enlarge ↗</span>
          </div>
          <MediaGallery media={entry.data.media} labels={labels} carousel />
        </aside>
      )}
    </div>
  </main>
</Layout>

<style>
  .journey-page {
    max-width: 1320px;
    padding-top: calc(var(--nav-h) + 55px);
    padding-bottom: 60px;
  }
  .archive,
  .eyebrow,
  .document-heading {
    font: 11px/1.6 var(--font-mono);
    letter-spacing: 0.04em;
  }
  .archive {
    color: #aaa;
    margin-bottom: 44px;
    display: inline-block;
  }
  .journey-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 90px);
    align-items: start;
  }
  .eyebrow {
    color: #ed8851;
    text-transform: uppercase;
  }
  .eyebrow span {
    color: #999;
  }
  h1 {
    font-size: clamp(36px, 4.3vw, 60px);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.045em;
    margin: 18px 0 26px;
  }
  .institution {
    font-size: 20px;
    line-height: 1.4;
  }
  .location {
    color: #a8ada5;
    margin-top: 7px;
    font-size: 14px;
  }
  .highlight {
    display: inline-block;
    color: #ed985f;
    border: 1px solid #b85d344f;
    padding: 10px 15px;
    margin: 28px 0 22px;
    font-size: 14px;
  }
  .intro {
    font-size: 17px;
    line-height: 1.8;
    color: #b8bdb5;
    max-width: 520px;
    margin-top: 28px;
  }
  .journey-details {
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid #ffffff20;
  }
  .journey-details :global(h2) {
    font-size: 19px;
    font-weight: 500;
    margin: 0 0 16px;
  }
  .journey-details :global(ul) {
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }
  .journey-details :global(li),
  .journey-details :global(p) {
    font-size: 14px;
    line-height: 1.8;
    color: #b8bdb5;
  }
  .journey-details :global(strong) {
    color: #ede8e1;
    font-weight: 500;
  }
  .documents {
    min-width: 0;
    padding: 22px;
    background: #171e18;
    border: 1px solid #ffffff20;
    border-radius: 4px;
  }
  .document-heading {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: #aeb5aa;
    font-size: 10px;
  }
  @media (max-width: 760px) {
    .journey-grid {
      grid-template-columns: 1fr;
    }
    .journey-page {
      padding-top: calc(var(--nav-h) + 30px);
    }
    .archive {
      margin-bottom: 30px;
    }
    .documents {
      padding: 16px;
    }
    h1 {
      font-size: 40px;
    }
  }
</style>
