---
import Layout from './Layout.astro';
import type { CollectionEntry } from 'astro:content';
import DocumentLink from '../components/project/DocumentLink.astro';
import MediaGallery from '../components/project/MediaGallery.astro';

interface Props {
  entry: any; // We'll pass the whole entry
}

const { entry } = Astro.props;
const { data } = entry;
const isSideBySideEnabled = entry.collection === 'recognition' || entry.collection === 'education' || entry.collection === 'journey';
const hasMediaContent = data.media && data.media.length > 0;
const shouldShowSideBySide = hasMediaContent || isSideBySideEnabled;
---

<Layout title={`${data.title} | Faizan Manshad`} description={data.deck || data.summary}>
  <article class={`container project-article ${shouldShowSideBySide ? 'has-media' : ''}`}>
    <div class="project-layout-grid">
      <div class="project-text-column">
        <header class="project-header">
      <div class="header-meta mono text-muted">
        {data.dateDisplay && <span>{data.dateDisplay}</span>}
        {data.type && <span> / {data.type}</span>}
      </div>
      <h1 class="project-title">{data.title}</h1>
      {data.deck && <p class="project-deck">{data.deck}</p>}
      
      <div class="project-details">
        {data.role && (
          <div class="detail-group">
            <span class="detail-label text-muted mono">ROLE</span>
            <span class="detail-value">{data.role}</span>
          </div>
        )}
        {data.organization && (
          <div class="detail-group">
            <span class="detail-label text-muted mono">CONTEXT</span>
            <span class="detail-value">{data.organization}</span>
          </div>
        )}
        {data.domains && data.domains.length > 0 && (
          <div class="detail-group">
            <span class="detail-label text-muted mono">DOMAIN</span>
            <span class="detail-value">{data.domains.join(', ')}</span>
          </div>
        )}
        {data.tools && data.tools.length > 0 && (
          <div class="detail-group">
            <span class="detail-label text-muted mono">TOOLS</span>
            <span class="detail-value">{data.tools.join(', ')}</span>
          </div>
        )}
      </div>
      
      {data.links && data.links.length > 0 && (
        <div class="project-links">
          {data.links.map((link: { url: string; label: string }) => (
            <DocumentLink href={link.url} label={link.label} type={link.url.includes('doi') ? 'doi' : 'link'} />
          ))}
        </div>
      )}
    </header>

        <div class="project-content">
          <slot />
        </div>
      </div>

      <div class="project-media-column">
        {hasMediaContent ? (
          <MediaGallery media={data.media} title={data.title} />
        ) : isSideBySideEnabled ? (
          <div class="empty-media-placeholder">
            <span>Image will be added soon</span>
          </div>
        ) : null}
      </div>
    </div>
    
    {data.videoEmbed && (
      <div class="project-video-embed">
        <div class="video-container" set:html={data.videoEmbed} />
      </div>
    )}
  </article>
</Layout>

<style>
  .project-article {
    padding-top: calc(var(--nav-h) + var(--s-6));
    padding-bottom: var(--s-16);
  }

  .project-header {
    margin-bottom: var(--s-12);
  }

  .header-meta {
    font-size: 0.875rem;
    margin-bottom: var(--s-4);
  }

  .project-title {
    margin-bottom: var(--s-4);
    color: var(--c-text);
  }

  .project-deck {
    font-size: 1.25rem;
    color: var(--c-text-muted);
    max-width: var(--max-w-editorial);
    margin-bottom: var(--s-8);
  }

  .project-details {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: var(--s-6);
    padding-top: var(--s-8);
    border-top: 1px solid var(--c-border);
  }

  .detail-group {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .detail-label {
    font-size: 0.75rem;
    letter-spacing: 0.05em;
  }

  .detail-value {
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .project-links {
    margin-top: var(--s-8);
    display: flex;
    gap: var(--s-4);
    flex-wrap: wrap;
  }

  .project-content {
    max-width: var(--max-w-editorial);
    font-size: 1.0625rem;
  }

  .project-content :global(h2) {
    margin-top: var(--s-12);
  }

  .project-footer {
    margin-top: var(--s-16);
    padding-top: var(--s-8);
    border-top: 1px solid var(--c-border);
  }

  .back-link {
    font-weight: 500;
  }

  .project-layout-grid {
    display: flex;
    flex-direction: column;
    gap: var(--s-16);
  }

  @media (min-width: 1024px) {
    .project-article.has-media .project-layout-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--s-16);
      align-items: start;
    }
    .project-article.has-media .project-media-column {
      position: sticky;
      top: calc(var(--nav-h) + var(--s-8));
    }
    .project-article.has-media .project-content {
      max-width: none;
    }
  }

  .empty-media-placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: #192019;
    border: 1px dashed #ffffff20;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--c-text-muted);
    font-family: var(--f-mono);
    font-size: 0.875rem;
    margin-top: var(--s-4);
  }

  .project-video-embed {
    margin-top: var(--s-16);
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .video-container {
    width: 75%;
    aspect-ratio: 16 / 9;
  }

  .video-container :global(iframe) {
    width: 100%;
    height: 100%;
    border-radius: 8px;
    border: 1px solid var(--c-border);
  }
</style>
