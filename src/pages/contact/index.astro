---
import Layout from "../../layouts/Layout.astro";
import { SITE_METADATA, contactEmail, linkedInProfile } from "../../consts";
---

<Layout
  title={SITE_METADATA.contact.title}
  description={SITE_METADATA.contact.description}
>
  <main class="contact-page container">
    <div class="contact-copy">
      <p class="eyebrow">CONTACT</p>
      <h1>Get in touch<span>.</span></h1>
      <p class="intro">If you’d like to discuss a project or ask about my work, send me a note here.</p>
      <a class="email" href={`mailto:${contactEmail}`}>{contactEmail} ↗</a>
      <p class="small">Taxila, Pakistan · <a href={linkedInProfile}>LinkedIn ↗</a></p>
    </div>
    <form id="contact-form" class="contact-form">
      <h2>A note to Faizan</h2>
      <label for="sender-name">
        Your name <span>(required)</span>
      </label>
      <input
        id="sender-name"
        name="name" required
        autocomplete="name"
        maxlength="100"
        placeholder="How should I address you?"
      />
      <label for="sender-email">
        Email address <span>(required)</span>
      </label>
      <input
        id="sender-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="254"
        placeholder="you@example.com"
      />
      <label for="sender-subject">
        Subject <span>(required)</span>
      </label>
      <input
        id="sender-subject"
        name="subject" required
        type="text"
        maxlength="160"
        placeholder="What is your message about?"
      />
      <label for="sender-message">
        Your message <span>(required)</span>
      </label>
      <textarea
        id="sender-message"
        name="message"
        rows="5"
        required
        maxlength="3000"
        placeholder="Tell me a little about what you have in mind…"
      ></textarea>
      <div class="hp-check" aria-hidden="true" style="position: absolute; left: -9999px; opacity: 0; pointer-events: none; height: 0; overflow: hidden;">
        <label for="contact-website-verification">Leave this field blank</label>
        <input
          id="contact-website-verification"
          name="_website_verification"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <button type="submit" disabled>
        Send message <span aria-hidden="true">↗</span>
      </button>
      <p id="contact-status" role="status" aria-live="polite"></p>
      <noscript>
        <p>
          Please email{" "}
          <a href={`mailto:${contactEmail}`}>{contactEmail}</a>{" "}
          directly.
        </p>
      </noscript>
    </form>
  </main>
</Layout>
<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const status = document.querySelector<HTMLElement>("#contact-status")!;
  const endpoint = import.meta.env.PUBLIC_CONTACT_ENDPOINT || "https://contact-api.faizanmanshad.com/message";
  let requestId = crypto.randomUUID();
  submit.disabled = false;
  form.addEventListener("input", () => { requestId = crypto.randomUUID(); status.textContent = ""; });
  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (submit.disabled || !form.reportValidity()) return;
    const fields = Object.fromEntries(new FormData(form));
    if (["name", "subject", "message"].some(key => !String(fields[key]).trim())) {
      status.textContent = "Please fill in your name, subject and message.";
      return;
    }
    submit.disabled = true;
    status.textContent = "Sending…";
    try {
      const response = await fetch(endpoint, { method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...fields, requestId }), signal: AbortSignal.timeout(15000) });
      if (!response.ok || !(await response.json()).accepted) throw new Error();
      form.reset();
      requestId = crypto.randomUUID();
      status.textContent = "Your message was accepted for delivery.";
    } catch {
      status.textContent = "We couldn’t confirm delivery. Try again or use the email link above.";
    } finally {
      submit.disabled = false;
    }
  });
</script>
<style>
  .contact-page {
    padding-top: 155px;
    padding-bottom: 90px;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 8vw;
    max-width: 1250px;
  }
  .eyebrow {
    font: 10px/1.8 var(--font-mono);
    letter-spacing: 0.1em;
    color: #aeb3ac;
  }
  h1 {
    font-size: clamp(35px, 4.2vw, 61px);
    line-height: 1.1;
    letter-spacing: -0.045em;
    margin: 30px 0;
  }
  h1 span {
    color: #e85c1a;
  }
  .intro {
    max-width: 390px;
    color: #b2b7ae;
    font-size: 17px;
    line-height: 1.7;
  }
  .email {
    display: inline-block;
    font-size: clamp(14px, 1.5vw, 20px);
    margin: 36px 0 15px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e85c1a;
  }
  .small {
    font-size: 12px;
    color: #aeb3ac;
    line-height: 1.7;
  }
  .contact-form {
    border: 1px solid #ffffff24;
    padding: 32px;
    background: #171d1880;
  }
  .contact-form h2 {
    font-size: 25px;
    font-weight: 500;
    letter-spacing: -0.03em;
    margin-bottom: 28px;
  }
  .contact-form label {
    display: block;
    margin: 22px 0 9px;
    font-size: 13px;
  }
  .contact-form label span {
    color: #aeb3ac;
    font-size: 11px;
  }
  .contact-form input,
  .contact-form textarea {
    display: block;
    width: 100%;
    border: 1px solid #ffffff30;
    border-radius: 0;
    background: #101412;
    color: #ede8e1;
    padding: 13px;
    font: 14px/1.5 var(--font-sans);
  }
  .contact-form textarea {
    resize: vertical;
    min-height: 130px;
  }
  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #939b90;
  }
  .contact-form input:focus,
  .contact-form textarea:focus {
    outline: 1px solid #e85c1a;
    border-color: #e85c1a;
  }
  .contact-form > .small {
    margin: 17px 0;
  }
  .contact-form button {
    display: flex;
    width: 100%;
    justify-content: space-between;
    background: #e85c1a;
    color: #101412;
    padding: 15px 20px;
    font: 14px var(--font-sans);
    border: 0;
    cursor: pointer;
  }
  .contact-form button:focus-visible {
    outline: 2px solid #ede8e1;
    outline-offset: 4px;
  }
  #contact-status {
    font-size: 12px;
    line-height: 1.7;
    margin-top: 15px;
    color: #c3c8be;
  }
  #contact-status:empty {
    display: none;
  }
  @media (max-width: 800px) {
    .contact-page {
      grid-template-columns: 1fr;
      gap: 35px;
      padding-top: 110px;
    }
    .contact-form {
      padding: 24px;
    }
  }
</style>
