---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import IndexList from "../../components/index/IndexList.astro";
import { Image } from "astro:assets";
import portrait from "../../assets/faizan.jpg";

const journey = await getCollection("journey");
const allItems = journey.sort((a, b) => {
  return (a.data.priority || 99) - (b.data.priority || 99);
});
---

<Layout
  title="About | Faizan Manshad"
  description="About Faizan Manshad, Civil Engineering student and BIM specialist."
>
  <main class="about-page container gsap-stagger-parent">
    <header class="about-header">
      <div class="index-header-meta">
        <p class="label index-label gsap-stagger-item">ABOUT ME</p>
      </div>
      <h1 class="index-title gsap-stagger-item">
        Curious about structures.
        <br />
        Always building something.
      </h1>
    </header>

    <div class="about-content gsap-stagger-item">
      <div class="about-image-wrapper">
        <div class="profile-portrait">
          <Image
            src={portrait}
            width={960}
            format="webp"
            alt="Faizan Manshad wearing glasses, a light shirt and tie, standing beside a brick wall"
          />
        </div>
      </div>

      <div class="about-text text-lg">
        <p>
          I’m Faizan. I’m interested in both structural engineering and Building
          Information Modelling: how a structure works, and how a good model
          helps us understand and build it. I enjoy moving between the
          engineering details and the digital tools that make them easier to
          work with.
        </p>
        <p>
          At <a href="/experience/urbana/">Urbana</a>, I work part-time as a
          Revit Drafter on modular infrastructure, mainly pedestrian bridges. My
          day-to-day work includes developing BIM models, preparing general
          arrangement and fabrication drawings, checking dimensions, and working
          through engineering review comments.
        </p>
        <p>
          At <a href="/experience/openspace/">OpenSpace</a>, I’m a Track
          Delivery Specialist. I review 360° site imagery across structural,
          architectural and MEP work, identify what is complete and what is
          still outstanding, and turn those observations into reliable
          construction-progress data.
        </p>
        <p>
          Alongside that, I spend time each day using AI tools to help develop
          Revit plugins. It’s an ongoing side project and a way to learn by
          building: trying ideas, testing them in Revit, and figuring out what
          makes a tool useful in everyday modelling work.
        </p>
        <p>
          That same curiosity led me to{" "}
          <a href="/research/bim-to-ar/">BIM-to-AR research</a>—exploring how a
          model can move beyond the screen and become something we can view in a
          physical space.
        </p>
      </div>
    </div>

    <section class="journey-section">
      <header class="index-header">
        <h2 class="index-title gsap-stagger-item">Community & Journey</h2>
        <p class="index-deck gsap-stagger-item">
          Beyond technical execution, contributing back to the community and
          environment.
        </p>
      </header>

      <div class="index-columns gsap-stagger-item">
        <span class="col-head col-head--year label">YEAR</span>
        <span class="col-head col-head--title label">TITLE</span>
        <span class="col-head col-head--domain label">DOMAIN</span>
        <span class="col-head col-head--context label">CONTEXT</span>
      </div>

      <div class="gsap-stagger-item">
        <IndexList items={allItems} />
      </div>
    </section>
  </main>
</Layout>

<script>
  import { gsap } from "gsap";
  gsap.fromTo(
    ".gsap-stagger-item",
    { opacity: 0, y: 20 },
    {
      opacity: 1,
      y: 0,
      duration: 0.8,
      stagger: 0.1,
      ease: "power2.out",
      delay: 0.2,
    },
  );
</script>

<style>
  .about-page {
    padding-top: calc(var(--nav-h) + var(--s-16));
    padding-bottom: var(--s-24);
    color: var(--c-text);
  }

  .about-header {
    margin-bottom: var(--s-16);
    max-width: 800px;
  }

  .index-label {
    color: var(--c-accent);
    margin-bottom: var(--s-4);
  }

  .index-title {
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
    margin-bottom: var(--s-4);
    color: var(--c-text);
  }

  .index-deck {
    font-size: var(--text-md);
    color: var(--c-muted);
    line-height: var(--leading-relaxed);
  }

  .about-content {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: var(--s-12);
    margin-bottom: var(--s-24);
  }

  .profile-portrait {
    width: 100%;
    aspect-ratio: 3/4;
    background-color: var(--c-surface);
    border: 1px solid var(--c-border);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: var(--c-muted);
  }

  .profile-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.75);
    transform-origin: 50% 28%;
  }
  .about-text a {
    color: #ed925f;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .about-image-wrapper {
    max-width: 420px;
  }

  .about-text {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--c-text);
  }

  .about-text p {
    margin-bottom: var(--s-6);
  }

  .journey-section {
    padding-top: var(--s-16);
    border-top: 1px solid var(--c-border);
  }

  .index-columns {
    display: grid;
    grid-template-columns: 80px 3fr 2fr 3fr;
    gap: var(--s-4);
    padding: var(--s-3) 0;
    border-bottom: 1px solid var(--c-border);
    color: var(--c-muted);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
  }

  @media (max-width: 768px) {
    .about-content {
      grid-template-columns: 1fr;
    }
    .index-columns {
      display: none;
    }
  }
</style>
