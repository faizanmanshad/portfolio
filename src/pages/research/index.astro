---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import researchCover from '../../assets/research-cover.png';

const research = await getCollection('research');
const allItems = research.sort((a, b) => {
  return (a.data.priority || 99) - (b.data.priority || 99);
});

const projects = await getCollection('projects');
---

<Layout
  title="Research Experience | Faizan Manshad"
  description="Academic research, R&D experiments, and technical investigations across civil engineering, BIM workflows, and tool development."
>
  <main class="research-directory-page container gsap-stagger-parent">
    <!-- Header -->
    <header class="page-header">
      <div class="header-eyebrow gsap-stagger-item">
        <span class="blueprint-badge">ARCHIVE // 02</span>
        <span class="eyebrow-sep">/</span>
        <span class="eyebrow-label">APPLIED RESEARCH &amp; R&amp;D</span>
      </div>

      <div class="header-main gsap-stagger-item">
        <h1 class="page-title">
          Research <span class="accent-text">Experience</span>
        </h1>
        <p class="page-deck">
          Academic studies, experimental prototypes, and applied R&amp;D across civil engineering, BIM workflows, and software tool development.
        </p>
      </div>
    </header>

    <!-- Research Directory List -->
    <section class="research-directory" aria-label="Research Experience Directory">
      <div class="directory-toolbar gsap-stagger-item">
        <div class="toolbar-title">
          <span class="toolbar-kicker mono">RESEARCH REGISTER</span>
          <h2 class="toolbar-heading">All Research ({allItems.length})</h2>
        </div>
      </div>

      <div class="research-list gsap-stagger-item">
        {allItems.map((item, idx) => (
          <article class="research-card">
            <a href={`/research/${item.id}/`} class="card-inner">
              <div class="card-media-col">
                <div class="card-image-frame">
                  <Image
                    src={researchCover}
                    alt={`${item.data.shortTitle || item.data.title} overview diagram`}
                    width={900}
                    format="webp"
                    class="card-image"
                  />
                  <div class="blueprint-scanline" aria-hidden="true"></div>
                </div>
              </div>

              <div class="card-body-col">
                <div class="card-top-meta">
                  <div class="card-index-row">
                    <span class="card-num mono">#{String(idx + 1).padStart(2, '0')}</span>
                    <span class="card-type mono">
                      {item.data.type || 'Research Study'}
                    </span>
                  </div>
                  <span class="card-year mono">{item.data.dateDisplay || '2026'}</span>
                </div>

                <div class="card-main-col">
                  <h3 class="card-title">{item.data.title}</h3>
                  <p class="card-org">
                    {item.data.organization}
                    {item.data.role ? ` · ${item.data.role}` : ''}
                  </p>

                  {item.data.summary && (
                    <p class="card-desc">{item.data.summary}</p>
                  )}
                </div>

                <div class="card-bottom-row">
                  <div class="card-tags">
                    {item.data.domains?.map((dom: string) => (
                      <span class="domain-tag mono">{dom}</span>
                    ))}
                  </div>
                  <span class="card-cta mono">
                    Open Study <span class="card-arrow" aria-hidden="true">↗</span>
                  </span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    </section>

    <!-- Page Footer Navigation -->
    <div class="page-footer-nav gsap-stagger-item">
      <a href="/academic/#research" class="back-link">
        <span aria-hidden="true">←</span> Return to Academic Dossier
      </a>
      <a href="/projects/" class="next-link">
        Explore Academic Projects ({projects.length}) <span aria-hidden="true">→</span>
      </a>
    </div>
  </main>
</Layout>

<style>
  .research-directory-page {
    padding-top: calc(var(--nav-h) + var(--s-12));
    padding-bottom: var(--s-24);
    color: var(--c-text);
  }

  /* Header */
  .page-header {
    margin-bottom: var(--s-10);
  }

  .header-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
  }

  .blueprint-badge {
    font: 11px/1.2 var(--font-mono);
    color: var(--c-accent);
    background: var(--c-accent-dim);
    padding: 3px 8px;
    border-radius: var(--r-sm);
    letter-spacing: var(--tracking-label);
  }

  .eyebrow-sep {
    color: var(--c-muted);
    font-size: 11px;
  }

  .eyebrow-label {
    font: 11px/1.2 var(--font-mono);
    color: var(--c-muted);
    letter-spacing: var(--tracking-label);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
    line-height: var(--leading-tight);
    margin-bottom: var(--s-3);
  }

  .accent-text {
    color: var(--c-accent);
  }

  .page-deck {
    font-size: var(--text-md);
    color: var(--c-muted);
    line-height: var(--leading-relaxed);
    max-width: 68ch;
    margin: 0;
  }

  /* Directory Section */
  .research-directory {
    margin-bottom: var(--s-16);
  }

  .directory-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--s-6);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-border);
  }

  .toolbar-kicker {
    font-size: 10px;
    color: var(--c-accent);
    letter-spacing: var(--tracking-label);
    display: block;
    margin-bottom: 4px;
  }

  .toolbar-heading {
    font-size: var(--text-xl);
    font-weight: 500;
    margin: 0;
  }

  .research-list {
    display: flex;
    flex-direction: column;
    gap: var(--s-5);
  }

  .research-card {
    background: radial-gradient(ellipse at top left, #1b221e 0%, #151a17 70%);
    border: 1px solid rgba(232, 92, 26, 0.35);
    border-radius: var(--r-md);
    transition: transform var(--t-ui), border-color var(--t-ui), box-shadow var(--t-ui);
    width: 100%;
  }

  .research-card:hover {
    transform: translateY(-3px);
    border-color: var(--c-accent);
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.45);
  }

  .card-inner {
    display: grid;
    grid-template-columns: minmax(280px, 380px) minmax(0, 1fr);
    align-items: stretch;
    padding: clamp(24px, 3.5vw, 34px);
    text-decoration: none;
    color: inherit;
    width: 100%;
    min-height: 290px;
    gap: clamp(24px, 3.5vw, 40px);
  }

  .card-media-col {
    display: flex;
    align-items: stretch;
  }

  .card-image-frame {
    position: relative;
    width: 100%;
    min-height: 220px;
    background: #0d100e;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--r-sm);
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s var(--ease-out), filter 0.4s var(--ease-out);
    filter: brightness(0.92) contrast(1.04);
  }

  .research-card:hover .card-image {
    transform: scale(1.03);
    filter: brightness(1);
  }

  .blueprint-scanline {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(232, 92, 26, 0.04) 3px,
      rgba(232, 92, 26, 0.04) 4px
    );
    pointer-events: none;
  }

  .card-body-col {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--s-5);
  }

  .card-top-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-3);
  }

  .card-index-row {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }

  .card-num {
    font-size: 12px;
    color: var(--c-accent);
    font-weight: 600;
  }

  .card-year {
    font-size: 11px;
    color: var(--c-muted);
  }

  .card-type {
    display: inline-block;
    width: fit-content;
    font-size: 10px;
    color: #ffd166;
    background: rgba(255, 209, 102, 0.1);
    padding: 3px 8px;
    border-radius: 2px;
    letter-spacing: 0.05em;
  }

  .card-org {
    font-size: 13px;
    line-height: 1.5;
    color: #9fa797;
    margin: 0;
  }

  .card-main-col {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
  }

  .card-title {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    font-weight: 500;
    line-height: 1.28;
    color: var(--c-text);
    margin: 0;
    transition: color var(--t-micro);
  }

  .research-card:hover .card-title {
    color: var(--c-accent);
  }

  .card-desc {
    font-size: 14px;
    line-height: 1.65;
    color: #c0c8b9;
    margin: 0;
    max-width: 72ch;
  }

  .card-bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
    padding-top: var(--s-4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .domain-tag {
    font-size: 10px;
    color: #b5beb0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3px 8px;
    border-radius: 2px;
  }

  .card-cta {
    font-size: 11px;
    color: var(--c-accent);
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    border: 1px solid rgba(232, 92, 26, 0.35);
    border-radius: var(--r-sm);
    background: rgba(232, 92, 26, 0.08);
    white-space: nowrap;
  }

  .card-arrow {
    transition: transform var(--t-micro);
  }

  .research-card:hover .card-arrow {
    transform: translate(2px, -2px);
  }

  /* Footer Nav */
  .page-footer-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
    padding-top: var(--s-8);
    border-top: 1px solid var(--c-border);
  }

  .back-link,
  .next-link {
    font: 12px/1.4 var(--font-mono);
    color: var(--c-muted);
    text-decoration: none;
    transition: color var(--t-micro);
  }

  .back-link:hover,
  .next-link:hover {
    color: var(--c-accent);
  }

  @media (max-width: 860px) {
    .card-inner {
      grid-template-columns: 1fr;
      min-height: auto;
      gap: var(--s-5);
    }
    .card-image-frame {
      aspect-ratio: 16/10;
      min-height: auto;
    }
  }
</style>
