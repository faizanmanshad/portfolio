---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import ResearchFigures from '../../components/academic/ResearchFigures.astro';

export async function getStaticPaths() {
  const research = await getCollection('research');
  return research.map(entry => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const projects = await getCollection('projects');
const isBimToAr = entry.id === 'bim-to-ar';
---

{isBimToAr ? (
  <Layout
    title={`${entry.data.shortTitle || entry.data.title} | Faizan Manshad`}
    description={entry.data.summary || 'Academic research, preprint, and multimodal BIM-to-AR framework for construction layout visualization.'}
  >
    <main class="research-study-page container gsap-stagger-parent">
      <!-- Header -->
      <header class="page-header">
        <div class="header-eyebrow gsap-stagger-item">
          <a href="/research/" class="back-crumb mono">← RESEARCH EXPERIENCE</a>
          <span class="eyebrow-sep">/</span>
          <span class="blueprint-badge">STUDY // 01</span>
          <span class="eyebrow-sep">/</span>
          <span class="eyebrow-label">APPLIED INQUIRY &amp; FINAL YEAR PROJECT</span>
        </div>

        <div class="header-main gsap-stagger-item">
          <h1 class="page-title">
            BIM to <span class="accent-text">Augmented Reality</span>
          </h1>
          <p class="page-deck">
            {entry.data.title} — Final Year Project investigation at COMSATS University Islamabad, Wah Campus exploring Android-based on-site building layout visualization.
          </p>
        </div>

        <!-- Quick Publication Metrics -->
        <div class="metrics-bar gsap-stagger-item" role="region" aria-label="Research Metrics">
          <div class="metric-item">
            <span class="metric-num highlight">01</span>
            <span class="metric-name">FYP MANUSCRIPT</span>
          </div>
          <div class="metric-item">
            <span class="metric-num">SSRN</span>
            <span class="metric-name">PREPRINT ARCHIVE</span>
          </div>
          <div class="metric-item">
            <span class="metric-num">IN REVIEW</span>
            <span class="metric-name">JOURNAL RESUBMISSION</span>
          </div>
          <div class="metric-item">
            <span class="metric-num">1ST</span>
            <span class="metric-name">AUTHOR POSITION</span>
          </div>
        </div>
      </header>

      <!-- Premier Manuscript Showcase -->
      <section class="manuscript-hero gsap-stagger-item" aria-label="Research Manuscript Overview">
        <div class="manuscript-card">
          <!-- Visual Carousel & Blueprint Column -->
          <div class="manuscript-visual-wrap">
            <ResearchFigures />

            <!-- Rapid Badges -->
            <div class="doi-pill-box">
              <div class="status-indicator">
                <span class="pulse-dot"></span>
                <span class="mono">SSRN DOI: 10.2139/ssrn.6884926</span>
              </div>
              <span class="access-pill mono">UNDER PEER REVIEW</span>
            </div>
          </div>

          <!-- Manuscript Information Column -->
          <div class="manuscript-details">
            <div class="manuscript-meta-tags">
              <span class="category-badge mono">SSRN PREPRINT · JOURNAL UNDER REVIEW</span>
              <span class="year-badge mono">{entry.data.dateDisplay || '2026'}</span>
            </div>

            <h2 class="manuscript-title">{entry.data.title}</h2>

            <!-- Author Byline -->
            <div class="author-byline">
              <span class="byline-label mono">AUTHORS:</span>
              <p class="byline-names">
                <strong>Faizan Manshad</strong>, Kashan Shafiq, Hassan Ashraf <span class="corr-badge">(Corresponding Author)</span>, and Faiz Fareed
              </p>
              <p class="byline-affil">COMSATS University Islamabad, Wah Campus · Final Year Project (FYP)</p>
            </div>

            <!-- Project Summary -->
            <div class="abstract-box">
              <span class="abstract-label mono">PROJECT SUMMARY</span>
              <p class="abstract-text">{entry.data.summary}</p>
              <p class="abstract-subtext">
                Physical device tests demonstrated practical model placement behavior across all three workflows, though they did not establish a numerical setting-out tolerance.
              </p>
            </div>

            <!-- Toolstack Matrix -->
            <div class="tools-matrix">
              <span class="matrix-label mono">TECHNOLOGY PIPELINE</span>
              <div class="tools-chips">
                <span class="tool-chip">Autodesk Revit</span>
                <span class="tool-chip">Unity 3D</span>
                <span class="tool-chip">Vuforia Engine</span>
                <span class="tool-chip">Google ARCore</span>
                <span class="tool-chip">Cesium for Unity</span>
                <span class="tool-chip">FBX Export</span>
                <span class="tool-chip">C# Scripting</span>
              </div>
            </div>

            <!-- CTAs -->
            <div class="manuscript-actions">
              {entry.data.links?.map((link: { url: string; label: string }) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer" class="btn-primary">
                  <span>{link.label}</span>
                  <span class="btn-arrow" aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- Framework Architecture Pillars -->
      <section class="framework-section gsap-stagger-item" aria-label="The 3 Multimodal Deployment Modes">
        <div class="section-title-wrap">
          <span class="section-kicker mono">02.1 / CORE CONTRIBUTION</span>
          <h2 class="section-heading">Three ways to place the model</h2>
          <p class="section-desc">We tested the building layout with three ways of placing it on an Android phone screen.</p>
        </div>

        <div class="pillars-grid">
          <!-- Pillar 01 -->
          <article class="pillar-card">
            <div class="pillar-header">
              <span class="pillar-num mono">01</span>
              <span class="pillar-tag mono">PRINTED MARKER</span>
            </div>
            <div class="pillar-icon-box" aria-hidden="true">
              <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 3v4M12 17v4M3 12h4M17 12h4"/>
                <circle cx="12" cy="12" r="2" fill="currentColor"/>
              </svg>
            </div>
            <h3 class="pillar-title">Marker-Based Target Tracking</h3>
            <p class="pillar-tech mono">Vuforia Engine · 2D Plan Benchmarks</p>
            <p class="pillar-desc">The phone recognizes a printed image target and anchors the building model relative to that benchmark.</p>
          </article>

          <!-- Pillar 02 -->
          <article class="pillar-card pillar-card--featured">
            <div class="pillar-header">
              <span class="pillar-num mono">02</span>
              <span class="pillar-tag mono">GROUND PLANE</span>
            </div>
            <div class="pillar-icon-box" aria-hidden="true">
              <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <rect x="3" y="14" width="18" height="7" rx="1"/>
                <path d="M7 14V6l10 4v4"/>
                <path d="M17 10L7 6"/>
              </svg>
            </div>
            <h3 class="pillar-title">Ground-Plane Surface AR</h3>
            <p class="pillar-tech mono">Google ARCore · Surface Raycasting</p>
            <p class="pillar-desc">The user places the Revit model directly onto a detected horizontal surface and adjusts its orientation on screen.</p>
          </article>

          <!-- Pillar 03 -->
          <article class="pillar-card">
            <div class="pillar-header">
              <span class="pillar-num mono">03</span>
              <span class="pillar-tag mono">GEOGRAPHIC COORDINATES</span>
            </div>
            <div class="pillar-icon-box" aria-hidden="true">
              <svg class="pillar-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
                <circle cx="12" cy="12" r="9"/>
                <ellipse cx="12" cy="12" rx="4" ry="9"/>
                <path d="M3 12h18"/>
              </svg>
            </div>
            <h3 class="pillar-title">Geospatial Location-Based AR</h3>
            <p class="pillar-tech mono">Cesium for Unity · WGS84 Georeferencing</p>
            <p class="pillar-desc">Geospatial placement locks the BIM geometry to site latitude, longitude, and elevation coordinates using Cesium for Unity.</p>
          </article>
        </div>
      </section>

      <!-- Technical Pipeline Workflow -->
      <section class="pipeline-section gsap-stagger-item" aria-label="Research Methodology Pipeline">
        <div class="section-title-wrap">
          <span class="section-kicker mono">02.2 / METHODOLOGY</span>
          <h2 class="section-heading">From Revit to Android</h2>
          <p class="section-desc">Standardized export and Unity deployment workflow across all three augmented reality modes.</p>
        </div>

        <div class="pipeline-flow">
          <div class="flow-step">
            <div class="step-badge mono">STEP 01</div>
            <h3 class="step-title">Parametric BIM Authoring</h3>
            <p class="step-desc">Modeled the architectural building layout in Autodesk Revit.</p>
          </div>

          <div class="flow-arrow" aria-hidden="true">→</div>

          <div class="flow-step">
            <div class="step-badge mono">STEP 02</div>
            <h3 class="step-title">FBX Export &amp; Scaling</h3>
            <p class="step-desc">Exported geometry as FBX and verified scale and axis orientation in Unity 3D.</p>
          </div>

          <div class="flow-arrow" aria-hidden="true">→</div>

          <div class="flow-step">
            <div class="step-badge mono">STEP 03</div>
            <h3 class="step-title">AR Tracking &amp; C# Controls</h3>
            <p class="step-desc">Configured Vuforia, ARCore, and Cesium tracking with custom C# interaction scripts.</p>
          </div>

          <div class="flow-arrow" aria-hidden="true">→</div>

          <div class="flow-step">
            <div class="step-badge mono">STEP 04</div>
            <h3 class="step-title">Physical Device Testing</h3>
            <p class="step-desc">Tested compiled Android builds on site to compare placement stability and workflow usability.</p>
          </div>
        </div>
      </section>

      <!-- Publication Status Section -->
      <section class="publication-section gsap-stagger-item" aria-label="Publication Status">
        <div class="section-title-wrap">
          <span class="section-kicker mono">02.3 / PUBLICATION STATUS</span>
          <h2 class="section-heading">Manuscript &amp; Review Record</h2>
          <p class="section-desc">Current archival availability and peer-review status of the Final Year Project study.</p>
        </div>

        <div class="status-grid">
          <article class="pillar-card">
            <div class="pillar-header">
              <span class="pillar-num mono">AUTHORS</span>
              <span class="pillar-tag mono">BYLINE</span>
            </div>
            <h3 class="pillar-title">Authorship</h3>
            <p class="pillar-tech mono">COMSATS University Islamabad, Wah Campus</p>
            <p class="pillar-desc">
              <strong>Faizan Manshad</strong> (First Author), Kashan Shafiq, <strong>Hassan Ashraf</strong> (Corresponding Author), and Faiz Fareed.
            </p>
          </article>

          <article class="pillar-card">
            <div class="pillar-header">
              <span class="pillar-num mono">PREPRINT</span>
              <span class="pillar-tag mono">OPEN ACCESS</span>
            </div>
            <h3 class="pillar-title">SSRN Preprint Archive</h3>
            <p class="pillar-tech mono">DOI: 10.2139/ssrn.6884926</p>
            <p class="pillar-desc">
              Publicly archived as a working manuscript on SSRN so reviewers and practitioners can inspect the framework details.
            </p>
          </article>

          <article class="pillar-card pillar-card--featured">
            <div class="pillar-header">
              <span class="pillar-num mono">JOURNAL</span>
              <span class="pillar-tag mono">IN REVIEW</span>
            </div>
            <h3 class="pillar-title">Under Peer Review</h3>
            <p class="pillar-tech mono">Resubmitted Manuscript</p>
            <p class="pillar-desc">
              Following an earlier unpublished journal submission, the revised study has been resubmitted to another journal and is currently under peer review.
            </p>
          </article>
        </div>
      </section>

      <!-- Page Footer Navigation -->
      <div class="page-footer-nav gsap-stagger-item">
        <div class="footer-left-links">
          <a href="/research/" class="back-link">
            <span aria-hidden="true">←</span> All Research Experience
          </a>
          <span class="eyebrow-sep" aria-hidden="true">·</span>
          <a href="/academic/#research" class="back-link">
            Return to Academic Dossier
          </a>
        </div>
        <a href="/projects/" class="next-link">
          Explore Academic Projects ({projects.length}) <span aria-hidden="true">→</span>
        </a>
      </div>
    </main>
  </Layout>
) : (
  <ProjectLayout entry={entry}>
    <Content />
  </ProjectLayout>
)}

<style>
  .research-study-page {
    padding-top: calc(var(--nav-h) + var(--s-12));
    padding-bottom: var(--s-24);
    color: var(--c-text);
  }

  .page-header {
    margin-bottom: var(--s-12);
  }

  .header-eyebrow {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-bottom: var(--s-4);
  }

  .back-crumb {
    font: 11px/1.2 var(--font-mono);
    color: var(--c-muted);
    text-decoration: none;
    letter-spacing: var(--tracking-label);
    transition: color var(--t-micro);
  }

  .back-crumb:hover {
    color: var(--c-accent);
  }

  .blueprint-badge {
    font: 11px/1.2 var(--font-mono);
    color: var(--c-accent);
    background: var(--c-accent-dim);
    padding: 3px 8px;
    border-radius: var(--r-sm);
    letter-spacing: var(--tracking-label);
  }

  .eyebrow-sep {
    color: var(--c-muted);
    font-size: 11px;
  }

  .eyebrow-label {
    font: 11px/1.2 var(--font-mono);
    color: var(--c-muted);
    letter-spacing: var(--tracking-label);
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 3.25rem);
    letter-spacing: var(--tracking-tight);
    font-weight: 500;
    line-height: var(--leading-tight);
    margin-bottom: var(--s-3);
  }

  .accent-text {
    color: var(--c-accent);
  }

  .page-deck {
    font-size: var(--text-md);
    color: var(--c-muted);
    line-height: var(--leading-relaxed);
    max-width: 72ch;
    margin-bottom: var(--s-8);
  }

  .metrics-bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    gap: var(--s-4);
    background: var(--c-surface);
    border: 1px solid var(--c-border);
    border-radius: var(--r-md);
    padding: var(--s-5) var(--s-6);
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    gap: var(--s-1);
  }

  .metric-num {
    font-size: clamp(1.25rem, 2vw, 1.75rem);
    font-weight: 600;
    font-family: var(--font-mono);
    color: var(--c-text);
    line-height: 1;
  }

  .metric-num.highlight {
    color: var(--c-accent);
  }

  .metric-name {
    font: 10px/1.3 var(--font-mono);
    color: var(--c-muted);
    letter-spacing: var(--tracking-wide);
  }

  /* Hero Manuscript Card */
  .manuscript-hero {
    margin-bottom: var(--s-20);
  }

  .manuscript-card {
    background: radial-gradient(ellipse at top left, #1d2520 0%, #151a17 60%, #101412 100%);
    border: 1px solid rgba(232, 92, 26, 0.35);
    border-radius: var(--r-md);
    padding: clamp(24px, 4vw, 44px);
    display: grid;
    grid-template-columns: 1.1fr 1.3fr;
    gap: clamp(24px, 4vw, 48px);
    box-shadow: 0 12px 48px rgba(0, 0, 0, 0.45);
    position: relative;
    overflow: hidden;
  }

  .manuscript-visual-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--s-4);
  }

  .manuscript-visual-link {
    text-decoration: none;
    color: inherit;
    display: block;
    position: relative;
  }

  .image-frame {
    position: relative;
    background: #0d100e;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--r-sm);
    overflow: hidden;
    aspect-ratio: 16/10;
  }

  .cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s var(--ease-out), filter 0.4s var(--ease-out);
    filter: brightness(0.92) contrast(1.05);
  }

  .manuscript-visual-link:hover .cover-image {
    transform: scale(1.03);
    filter: brightness(1);
  }

  .blueprint-scanline {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 3px,
      rgba(232, 92, 26, 0.04) 3px,
      rgba(232, 92, 26, 0.04) 4px
    );
    pointer-events: none;
  }

  .blueprint-crosshair {
    position: absolute;
    width: 12px;
    height: 12px;
    pointer-events: none;
  }

  .blueprint-crosshair.top-left {
    top: 8px;
    left: 8px;
    border-top: 2px solid var(--c-accent);
    border-left: 2px solid var(--c-accent);
  }

  .blueprint-crosshair.bottom-right {
    bottom: 8px;
    right: 8px;
    border-bottom: 2px solid var(--c-accent);
    border-right: 2px solid var(--c-accent);
  }

  .visual-caption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--s-2);
  }

  .caption-tag {
    font-size: 10px;
    color: #8e9587;
    letter-spacing: 0.04em;
  }

  .caption-action {
    font-size: 10px;
    color: var(--c-accent);
    letter-spacing: 0.04em;
  }

  .doi-pill-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--r-sm);
    padding: 8px 12px;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    color: #ede8e1;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #62d26f;
    box-shadow: 0 0 8px #62d26f;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .access-pill {
    font-size: 10px;
    color: #ffd166;
    letter-spacing: 0.05em;
  }

  .manuscript-details {
    display: flex;
    flex-direction: column;
  }

  .manuscript-meta-tags {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-3);
  }

  .category-badge {
    font-size: 10px;
    color: var(--c-accent);
    letter-spacing: var(--tracking-label);
  }

  .year-badge {
    font-size: 10px;
    color: var(--c-muted);
  }

  .manuscript-title {
    font-size: clamp(1.35rem, 2.3vw, 1.8rem);
    font-weight: 500;
    line-height: 1.25;
    color: var(--c-text);
    margin-bottom: var(--s-4);
  }

  .author-byline {
    padding-bottom: var(--s-4);
    margin-bottom: var(--s-4);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .byline-label {
    font-size: 9px;
    color: var(--c-muted);
    letter-spacing: 0.1em;
    display: block;
    margin-bottom: 2px;
  }

  .byline-names {
    font-size: 13px;
    color: #d8decf;
    margin: 0 0 2px;
  }

  .corr-badge {
    color: var(--c-accent);
    font-weight: 500;
  }

  .byline-affil {
    font-size: 11px;
    color: #8e9587;
    margin: 0;
  }

  .abstract-box {
    margin-bottom: var(--s-5);
  }

  .abstract-label {
    font-size: 10px;
    color: var(--c-accent);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 6px;
  }

  .abstract-text {
    font-size: 14px;
    line-height: 1.65;
    color: #c0c8b9;
    margin-bottom: var(--s-2);
  }

  .abstract-subtext {
    font-size: 13px;
    line-height: 1.6;
    color: #8e9587;
    margin: 0;
  }

  .tools-matrix {
    margin-bottom: var(--s-6);
  }

  .matrix-label {
    font-size: 10px;
    color: var(--c-muted);
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 8px;
  }

  .tools-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tool-chip {
    font: 11px/1.2 var(--font-mono);
    color: #b5beb0;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3px 8px;
    border-radius: 2px;
  }

  .manuscript-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: auto;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--c-accent);
    color: #fff;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: var(--r-sm);
    font: 12px/1.2 var(--font-mono);
    letter-spacing: 0.02em;
    font-weight: 500;
    transition: background var(--t-ui), transform var(--t-ui);
  }

  .btn-primary:hover {
    background: #f06e30;
    transform: translateY(-2px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #ede8e1;
    text-decoration: none;
    padding: 10px 18px;
    border-radius: var(--r-sm);
    font: 12px/1.2 var(--font-mono);
    cursor: pointer;
    transition: all var(--t-ui);
  }

  .btn-secondary:hover {
    border-color: var(--c-accent);
    color: var(--c-accent);
    transform: translateY(-2px);
  }

  .btn-arrow {
    transition: transform var(--t-micro);
  }

  .btn-secondary:hover .btn-arrow {
    transform: translate(2px, -2px);
  }

  /* Shared Section Headings */
  .section-title-wrap {
    margin-bottom: var(--s-8);
  }

  .section-kicker {
    font-size: 11px;
    color: var(--c-accent);
    letter-spacing: var(--tracking-label);
    display: block;
    margin-bottom: 4px;
  }

  .section-heading {
    font-size: var(--text-xl);
    font-weight: 500;
    margin: 0 0 var(--s-2);
  }

  .section-desc {
    font-size: var(--text-base);
    color: var(--c-muted);
    max-width: 65ch;
    margin: 0;
