---
import { getCollection, render } from 'astro:content';
import ProjectLayout from '../../layouts/ProjectLayout.astro';
import TrussBridgePage from '../../components/recognition/TrussBridgePage.astro';

export async function getStaticPaths() {
  const recognition = await getCollection('recognition');
  return recognition.map(entry => ({
    params: { id: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

{entry.id === 'truss-bridge-competition' ? <TrussBridgePage media={entry.data.media || []} /> : <ProjectLayout entry={entry}>
  <Content />
</ProjectLayout>}
