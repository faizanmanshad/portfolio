  }
  .explore-model:hover {
    border-color: #e97939;
    background: #e9793910;
  }
  .explore-model span {
    font-size: 18px;
    color: #e97939;
  }
  .skip-model {
    display: block;
    font-size: 10px;
    color: #969d8c;
    margin-top: 18px;
  }
  .studio-model {
    position: absolute;
    left: 36%;
    right: 1%;
    top: 125px;
    bottom: 115px;
  }
  .model-coordinate {
    position: absolute;
    top: 6px;
    right: 8%;
    font: 8px var(--font-mono);
    letter-spacing: 0.15em;
    color: #8a9283;
  }
  .studio-caption {
    position: absolute;
    bottom: 60px;
    left: 5%;
    right: 5%;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid #c5c5ad30;
    padding-top: 22px;
    font: 9px var(--font-mono);
    letter-spacing: 0.1em;
    color: #adb09e;
  }
  .studio-caption i {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e97939;
