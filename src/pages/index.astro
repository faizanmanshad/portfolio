---
import Layout from "../layouts/Layout.astro";
import StudioScene from "../components/studio/StudioScene";
import { getCollection } from "astro:content";
const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.priority - b.data.priority,
);
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.priority - b.data.priority,
);
const research = await getCollection("research");
const urbana = experience.find((item) => item.id === "urbana")!;
const openspace = experience.find((item) => item.id === "openspace")!;
const ar = research.find((item) => item.id === "bim-to-ar")!;
const records = {
  structure: {
    title: "From drawing to structure",
    label: "Structures & BIM",
    description:
      "Architectural and structural modelling, engineering drawings, and the details that connect a design to its construction.",
    href: "/projects/",
  },
  practice: {
    title: openspace.data.shortTitle || openspace.data.title,
    label: "Digital construction",
    description: openspace.data.summary || "",
    href: `/experience/${openspace.id}/`,
  },
  research: {
    title: ar.data.shortTitle || ar.data.title,
    label: "Research & AR",
    description: ar.data.summary || "",
    href: `/research/${ar.id}/`,
  },
};
---

<Layout
  title="Faizan Manshad — The Engineering Studio"
  description="Civil engineering. Digital curiosity. Explore Faizan Manshad's work in structures, BIM, digital construction and augmented reality."
  mode="explore"
>
  <div id="global-intro-loader" style="position: fixed; inset: 0; z-index: 2147483647; background: #101412; display: flex; align-items: center; justify-content: center; transition: opacity 0.4s ease-in-out;">
    <p style="color: #8b9586; font: 9px var(--font-mono); letter-spacing: 0.15em;">SETTING OUT THE STUDIO...</p>
    <script is:inline>
      if (sessionStorage.getItem('skipIntro') === 'true') {
        document.getElementById('global-intro-loader').style.display = 'none';
      }
    </script>
  </div>
  <main class="studio-page">
    <section
      class="studio-hero"
      id="studio"
      aria-label="Faizan Manshad's engineering studio"
    >
      <div class="studio-sheet-meta">
        <span>PORTFOLIO / FAIZAN MANSHAD</span>
        <span>AN EXPLORATION OF THE BUILT WORLD</span>
      </div>
      <div class="studio-intro">
        <p class="studio-eyebrow">
          <span></span> CIVIL ENGINEERING
          <br />
          WITH A DIGITAL PERSPECTIVE
        </p>
        <div
          class="name-drawing"
          tabindex="0"
          aria-label="Faizan Manshad — hover to inspect the lettering"
        >
          <span class="dimension dimension-top" aria-hidden="true">
            IDENTITY / 01
          </span>
          <h1>
            FAIZAN
            <br />
            MANSHAD
          </h1>
          <div class="name-outline" aria-hidden="true">
            FAIZAN
            <br />
            MANSHAD
          </div>
          <span class="dimension dimension-bottom" aria-hidden="true">
            PHYSICAL ↔ DIGITAL
          </span>
        </div>
        <p class="studio-tagline">
          Civil engineering.
          <br />
          <span>Digital curiosity.</span>
        </p>
        <p class="studio-intro-copy">
          I work where structures, information,
          <br class="desktop-break" /> and emerging technology meet.
        </p>
        <button class="explore-model" id="explore-model">
          EXPLORE THE MODEL <span>↗</span>
        </button>
        <a class="skip-model" href="#selected-work">
          Or, go straight to the work ↓
        </a>
      </div>
      <div class="studio-model">
        <span class="model-coordinate" aria-hidden="true">
          PERSPECTIVE / 01
        </span>
        <StudioScene records={records} client:load>
          <div slot="fallback" class="studio-static">
            <img
              src="/images/studio-fallback.svg"
              alt="Isometric architectural drawing of a pavilion and bridge"
            />
            <p class="label">STRUCTURES / CONSTRUCTION / RESEARCH</p>
          </div>
        </StudioScene>
      </div>
      <div class="studio-caption">
        <span>
          <i></i> THE STUDIO — ONE MODEL, MANY STORIES
        </span>
        <span>DRAG TO ROTATE · SELECT A DETAIL</span>
      </div>
      <span class="studio-model-note">
        An illustrative model. A window into my practice.
      </span>
    </section>

    <section class="studio-principles" aria-label="Explore the studio">
      <p class="section-kicker">01 / WAYS OF SEEING</p>
      <div class="principle-grid">
        <div>
          <span class="principle-symbol">⌖</span>
          <h2>Look closer.</h2>
          <p>Select a connection. Discover the work and thinking behind it.</p>
        </div>
        <div>
          <span class="principle-symbol">↻</span>
          <h2>Change perspective.</h2>
          <p>
            Turn the model. Switch to its blueprint. See how the pieces relate.
          </p>
        </div>
        <div>
          <span class="principle-symbol">↥</span>
          <h2>Take it apart.</h2>
          <p>
            Explore the layers, from the structural frame to the digital model.
          </p>
        </div>
      </div>
    </section>

    <section class="selected-work" id="selected-work">
      <div class="section-heading">
        <div>
          <p class="section-kicker">02 / SELECTED PRACTICE</p>
          <h2>
            From the model.
            <br />
            <span>Into the real world.</span>
          </h2>
        </div>
        <a href="/work/" class="text-link">
          ALL EXPERIENCE ↗
        </a>
      </div>
      <div class="practice-grid">
        <a class="practice-card" href={`/experience/${urbana.id}/`}>
          <div class="practice-art bridge-art" aria-hidden="true">
            <svg viewBox="0 0 600 330" fill="none">
              <path d="M70 240 210 140 530 180 390 280Z" fill="#252e2a" />
              <g stroke="#c6c1a7" stroke-width="3">
                <path d="M85 205 405 245 520 161 200 121Z M85 140 405 180 520 96 200 56Z M85 140V205 M405 180V245 M520 96V161 M200 56V121 M85 140 149 213 213 156 277 229 341 172 405 245 M200 56 264 129 328 72 392 145 456 88 520 161" />
              </g>
              <path d="m85 140 320 40" stroke="#e97939" stroke-width="5" />
              <g stroke="#888c7d" stroke-width="2">
                <path d="M149 148 264 64 M213 156 328 72 M277 164 392 80 M341 172 456 88" />
              </g>
              <circle cx="405" cy="180" r="7" fill="#e97939" />
            </svg>
            <span class="drawing-caption">MODULAR INFRASTRUCTURE / STUDY</span>
          </div>
          <div class="practice-meta">
            <span>01 / BIM & DETAILING</span>
            <span>{urbana.data.dateDisplay}</span>
          </div>
          <h3>
            {urbana.data.shortTitle} <span>↗</span>
          </h3>
          <p>{urbana.data.summary}</p>
          <span class="practice-role">{urbana.data.role}</span>
        </a>
        <a class="practice-card" href={`/experience/${openspace.id}/`}>
          <div class="practice-art capture-art" aria-hidden="true">
            <div class="capture-grid"></div>
            <div class="capture-ring ring-one"></div>
            <div class="capture-ring ring-two"></div>
            <div class="capture-cross"></div>
            <div class="capture-target">
              360°<span>SITE → INFORMATION</span>
            </div>
            <span class="drawing-caption">REALITY CAPTURE / PROGRESS</span>
          </div>
          <div class="practice-meta">
            <span>02 / DIGITAL CONSTRUCTION</span>
            <span>{openspace.data.dateDisplay}</span>
          </div>
          <h3>
            {openspace.data.shortTitle} <span>↗</span>
          </h3>
          <p>{openspace.data.summary}</p>
          <span class="practice-role">{openspace.data.role}</span>
        </a>
      </div>
    </section>

    <section class="research-feature">
      <div class="research-copy">
        <p class="section-kicker">03 / EXPERIMENTAL THINKING</p>
        <h2>
          What if the model
          <br />
          could leave
          <br />
          <em>the screen?</em>
        </h2>
        <p>{ar.data.summary}</p>
        <a class="text-link" href={`/research/${ar.id}/`}>
          EXPLORE BIM TO AR ↗
        </a>
        <span class="research-status">FYP RESEARCH / SSRN PREPRINT</span>
      </div>
      <a
        href={`/research/${ar.id}/`}
        class="research-art"
        aria-label="Explore BIM to augmented reality research"
      >
        <div class="ar-frame">
          <span class="ar-scanline"></span>
          <div class="ar-building">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <span class="ar-label">
            MODEL PLACED
            <br />
            PHYSICAL + DIGITAL
          </span>
        </div>
        <span class="ar-coordinate">MARKER / GROUND PLANE / LOCATION</span>
      </a>
    </section>

    <section class="project-register">
      <div class="section-heading">
        <div>
          <p class="section-kicker">04 / THE DRAWING REGISTER</p>
          <h2>Further explorations.</h2>
        </div>
        <a class="text-link" href="/projects/">
          ALL PROJECTS ↗
        </a>
      </div>
      {projects.map((item, i) => (
        <a class="register-row" href={`/projects/${item.id}/`}>
          <span class="register-number">0{i + 1}</span>
          <h3>{item.data.title}</h3>
          <span class="register-domain">{item.data.domains.join(" / ")}</span>
          <span>↗</span>
        </a>
      ))}
    </section>

    <footer class="studio-footer">
      <p class="section-kicker">PEOPLE. STRUCTURES. POSSIBILITIES.</p>
      <h2>
        Always curious.
        <br />
        <span>Always building.</span>
      </h2>
      <div>
        <a href="/about/">THE PERSON BEHIND THE WORK ↗</a>
        <a href="/contact/">LET'S CONNECT ↗</a>
        <a href="/academic/">ACADEMIC CV ↗</a>
      </div>
      <p class="footer-colophon">
        FAIZAN MANSHAD <span>CIVIL ENGINEERING / BIM / RESEARCH</span>
      </p>
    </footer>
  </main>
</Layout>
<script>
  const drawing = document.querySelector<HTMLElement>(".name-drawing");
  drawing?.addEventListener("pointermove", (event) => {
    const rect = drawing.getBoundingClientRect();
    drawing.style.setProperty("--inspect-x", `${event.clientX - rect.left}px`);
    drawing.style.setProperty("--inspect-y", `${event.clientY - rect.top}px`);
  });
  document.getElementById("explore-model")?.addEventListener("click", () => {
    window.dispatchEvent(new Event("studio:explore"));
    document
      .querySelector(".studio-model")
      ?.scrollIntoView({
        behavior: matchMedia("(prefers-reduced-motion: reduce)").matches
          ? "instant"
          : "smooth",
        block: "center",
      });
  });
</script>
<style>
  :global(body:has(.studio-page) #custom-cursor) {
    display: none;
  }
  @keyframes studio-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .studio-page {
    --studio-muted: #9c9e92;
    background: #101412;
  }
  .studio-page :global(button),
  .studio-page :global(a) {
    -webkit-tap-highlight-color: transparent;
  }
  .studio-hero {
    max-width: 1800px;
    margin: auto;
    position: relative;
    min-height: 790px;
    height: min(940px, 100svh);
    padding: 120px 5% 100px;
    display: grid;
    grid-template-columns: 37% 63%;
    isolation: isolate;
    overflow: clip;
    background: radial-gradient(ellipse at 70% 45%, #33372c42, transparent 65%);
  }
  .studio-sheet-meta {
    position: absolute;
    top: 86px;
    left: 5%;
    right: 5%;
    display: flex;
    justify-content: space-between;
    font: 8px var(--font-mono);
    letter-spacing: 0.17em;
    color: #727d71;
    padding-bottom: 16px;
    border-bottom: 1px solid #ffffff13;
  }
  .studio-intro {
    animation: studio-enter 850ms cubic-bezier(0.2, 0.7, 0.3, 1) both;
    position: relative;
    align-self: center;
    z-index: 2;
    padding-top: 12px;
    pointer-events: none;
  }
  .studio-intro > * {
    pointer-events: auto;
  }
  .studio-eyebrow {
    font: 9px/1.8 var(--font-mono);
    letter-spacing: 0.15em;
    color: #a9ad9e;
    margin-bottom: 36px;
  }
  .studio-eyebrow > span {
    display: inline-block;
    width: 22px;
    height: 2px;
    background: #e97939;
    margin-bottom: 8px;
    display: block;
  }
  .name-drawing {
    position: relative;
    width: max-content;
    max-width: 115%;
    margin: 0 0 28px -5px;
    padding: 10px 5px;
    cursor: crosshair;
    --inspect-x: 50%;
    --inspect-y: 50%;
  }
  .name-drawing h1,
  .name-outline {
    font-size: clamp(54px, 6.45vw, 112px);
    font-weight: 600;
    line-height: 0.91;
    letter-spacing: -0.06em;
    margin: 0;
  }
  .name-drawing::before,
  .name-drawing::after {
    content: "";
    position: absolute;
    inset: 0 -12px;
    border-top: 1px solid #ddd9c526;
    border-bottom: 1px solid #ddd9c526;
    pointer-events: none;
  }
  .name-drawing::after {
    inset: -10px 0;
    border: 0;
    border-left: 1px solid #ddd9c526;
    border-right: 1px solid #ddd9c526;
  }
  .dimension {
    position: absolute;
    font: 7px var(--font-mono);
    letter-spacing: 0.1em;
    color: #7d8578;
  }
  .dimension-top {
    top: -14px;
    right: 10px;
  }
  .dimension-bottom {
    bottom: -14px;
    left: 8px;
  }
  .name-outline {
    position: absolute;
    inset: 10px 5px;
    color: transparent;
    -webkit-text-stroke: 1px #f08b49;
    pointer-events: none;
    background: #101412;
    mask-image: radial-gradient(
      circle 65px at var(--inspect-x) var(--inspect-y),
      #000 75%,
      transparent 100%
    );
    opacity: 0;
  }
  .name-drawing:hover .name-outline,
  .name-drawing:focus-visible .name-outline {
    opacity: 1;
  }
  .studio-tagline {
    font-size: clamp(20px, 2vw, 31px);
    letter-spacing: -0.045em;
    line-height: 1.25;
    margin-top: 35px;
    margin-bottom: 15px;
  }
  .studio-tagline span {
    color: #b4b3a5;
  }
  .studio-intro-copy {
    color: #9fa294;
    font-size: 12px;
    line-height: 1.8;
    margin-bottom: 25px;
  }
  .explore-model {
    border: 1px solid #acae9466;
    background: #e0d6bd08;
    color: #e9e3d5;
    padding: 16px 20px;
    display: flex;
    gap: 35px;
    align-items: center;
    font: 9px var(--font-mono);
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .explore-model:hover {
    border-color: #e97939;
    background: #e9793910;
  }
  .explore-model span {
    font-size: 18px;
    color: #e97939;
  }
  .skip-model {
    display: block;
    font-size: 10px;
    color: #969d8c;
    margin-top: 18px;
  }
  .studio-model {
    position: absolute;
    left: 36%;
    right: 1%;
    top: 125px;
    bottom: 115px;
  }
  .model-coordinate {
    position: absolute;
    top: 6px;
    right: 8%;
    font: 8px var(--font-mono);
    letter-spacing: 0.15em;
    color: #8a9283;
  }
  .studio-caption {
    position: absolute;
    bottom: 60px;
    left: 5%;
    right: 5%;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    border-top: 1px solid #c5c5ad30;
    padding-top: 22px;
    font: 9px var(--font-mono);
    letter-spacing: 0.1em;
    color: #adb09e;
  }
  .studio-caption i {
    display: inline-block;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #e97939;
    margin-right: 10px;
  }
  .studio-model-note {
    position: absolute;
    bottom: 26px;
    left: 5%;
    font-size: 9px;
    color: #75806e;
  }
  .studio-static {
    height: 100%;
    display: grid;
    place-items: center;
  }
  .studio-static img {
    width: 100%;
  }
  .studio-static p {
    color: #aab29e;
  }
  .studio-principles,
  .selected-work,
  .project-register,
  .studio-footer {
    padding: 60px 5%;
    max-width: 1600px;
    margin: auto;
  }
  .section-kicker {
    font: 9px var(--font-mono);
    color: #9ba48f;
    letter-spacing: 0.12em;
    margin-bottom: 30px;
  }
  .studio-principles {
    border-top: 1px solid #ffffff12;
    padding-top: 35px;
    padding-bottom: 55px;
  }
  .principle-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 50px;
  }
  .principle-grid > div {
    padding-left: 25px;
    border-left: 1px solid #ffffff18;
  }
  .principle-symbol {
    display: block;
    color: #e48a51;
    font-size: 30px;
    margin-bottom: 20px;
  }
  .principle-grid h2 {
    font-size: 22px;
  }
  .principle-grid p {
    max-width: 260px;
    font-size: 12px;
    color: #939d8e;
    line-height: 1.8;
  }
  .selected-work {
    padding-top: 90px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 45px;
    gap: 30px;
  }
  .section-heading h2 {
    font-size: clamp(30px, 4vw, 58px);
    letter-spacing: -0.045em;
  }
  .section-heading h2 span {
    color: #8b9586;
  }
  .text-link {
    font: 10px var(--font-mono);
    padding-bottom: 14px;
    border-bottom: 1px solid #aaa58a55;
    white-space: nowrap;
  }
  .practice-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .practice-card {
    display: block;
  }
  .practice-art {
    aspect-ratio: 1.7;
    background: #1b211d;
    border: 1px solid #ffffff0f;
    position: relative;
    overflow: hidden;
  }
  .practice-art svg {
    height: 100%;
    width: 100%;
    transition: transform 0.7s;
  }
  .practice-card:hover svg {
    transform: translateY(-5px) rotate(-2deg);
  }
  .drawing-caption {
    position: absolute;
    bottom: 18px;
    left: 22px;
    color: #8b9587;
    font: 8px var(--font-mono);
    letter-spacing: 0.1em;
  }
  .practice-meta {
    display: flex;
    justify-content: space-between;
    font: 8px var(--font-mono);
    color: #939e8e;
    margin: 22px 0 14px;
    gap: 15px;
  }
  .practice-card h3 {
    display: flex;
    justify-content: space-between;
    font-size: 30px;
  }
  .practice-card h3 span {
    font-size: 22px;
    color: #a4aa98;
  }
  .practice-card p {
    color: #9ba592;
    font-size: 13px;
    max-width: 420px;
  }
  .practice-role {
    font: 9px var(--font-mono);
    color: #d4ceba;
  }
  .capture-art {
    display: grid;
    place-items: center;
  }
  .capture-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(#b6c1a509 1px, transparent 1px),
      linear-gradient(90deg, #b6c1a509 1px, transparent 1px);
    background-size: 28px 28px;
    transform: perspective(400px) rotateX(45deg) scale(1.5);
  }
  .capture-ring {
    position: absolute;
    width: 190px;
    height: 190px;
    border: 1px solid #7f8b6c66;
    border-radius: 50%;
  }
  .ring-two {
    width: 230px;
    height: 230px;
    border-style: dashed;
    border-color: #7f8b6c33;
  }
  .capture-target {
    font: 52px var(--font-sans);
    color: #d4cbb6;
    text-align: center;
    z-index: 1;
  }
  .capture-target span {
    display: block;
    font: 8px var(--font-mono);
    letter-spacing: 0.1em;
    color: #e97939;
  }
  .capture-cross {
    position: absolute;
    width: 260px;
    height: 1px;
    background: #b5c0a333;
  }
  .capture-cross::after {
    content: "";
    position: absolute;
    width: 1px;
    height: 230px;
    left: 50%;
    top: -115px;
    background: #b5c0a333;
  }
  .research-feature {
    margin: 90px 0;
    padding: 80px max(5%, calc((100vw - 1440px) / 2));
    background: #1a201a;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    border-block: 1px solid #ffffff12;
  }
  .research-copy h2 {
    font-size: clamp(38px, 4.5vw, 65px);
    letter-spacing: -0.04em;
  }
  .research-copy em {
    font-family: Georgia, serif;
    color: #b0b998;
    font-weight: 400;
  }
  .research-copy > p:not(.section-kicker) {
    font-size: 13px;
    max-width: 380px;
    color: #a2ad97;
    margin: 25px 0 35px;
  }
  .research-status {
    display: block;
    margin-top: 35px;
    font: 8px var(--font-mono);
    color: #89977d;
    letter-spacing: 0.1em;
  }
  .research-art {
    min-height: 320px;
    display: grid;
    place-items: center;
    position: relative;
    background: radial-gradient(ellipse, #65714c20, transparent 65%);
  }
  .ar-frame {
    width: 250px;
    height: 300px;
    border: 1px solid #a0af8380;
    transform: perspective(800px) rotateY(-18deg) rotateX(7deg);
    position: relative;
    display: grid;
    place-items: center;
    transition: transform 0.6s;
  }
  .research-art:hover .ar-frame {
    transform: perspective(800px) rotateY(0) rotateX(0);
  }
  .ar-frame::before,
  .ar-frame::after {
    content: "+";
    position: absolute;
    color: #e97939;
    font: 23px var(--font-mono);
  }
  .ar-frame::before {
    left: -8px;
    top: -13px;
  }
