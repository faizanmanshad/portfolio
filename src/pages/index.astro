    animation: studio-enter 400ms cubic-bezier(0.2, 0.7, 0.3, 1) 250ms both;
    position: relative;
    align-self: center;
    z-index: 2;
    padding-top: 12px;
    pointer-events: none;
  }
  .studio-intro > * {
    pointer-events: auto;
  }
  .studio-eyebrow {
    font: 9px/1.8 var(--font-mono);
    letter-spacing: 0.15em;
    color: #a9ad9e;
    margin-bottom: 36px;
  }
  .studio-eyebrow > span {
    display: inline-block;
    width: 22px;
    height: 2px;
    background: #e97939;
    margin-bottom: 8px;
