---
import Layout from "../layouts/Layout.astro";
import StudioScene from "../components/studio/StudioScene";
import { getCollection } from "astro:content";
const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.priority - b.data.priority,
);
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.priority - b.data.priority,
);
const research = await getCollection("research");
const recognition = (await getCollection("recognition")).sort(
  (a, b) => (a.data.priority ?? 99) - (b.data.priority ?? 99),
);
const urbana = experience.find((item) => item.id === "urbana")!;
const openspace = experience.find((item) => item.id === "openspace")!;
const ar = research.find((item) => item.id === "bim-to-ar")!;
// Build the guided visit from the same public records used by the archives.
const journeyCollections = await Promise.all([
  getCollection('education'), getCollection('recognition'), getCollection('journey'),
  getCollection('experience'), getCollection('projects'), getCollection('research'),
]);
const categoryNames: Record<string,string> = {education:'Education',recognition:'Recognition',journey:'Community',experience:'Professional Experience',projects:'Projects',research:'Research'};
// Curated highlights only. Add an ID here when a new major milestone is ready.
const majorMilestoneIds = new Set([
  'education/bs-civil-engineering',
  'projects/rcd-school-building-design',
  'research/bim-to-ar',
  'recognition/gold-medalist',
  'experience/urbana',
  'experience/openspace',
]);
const datedJourney = journeyCollections.flat().filter(item => majorMilestoneIds.has(`${item.collection}/${item.id}`)).map(item => {
  const year = item.data.dateDisplay?.match(/(?:19|20)\d{2}/)?.[0];
  const order = item.data.dateStart?.getTime() ?? (year ? Date.UTC(Number(year),0,1) : Infinity);
  return {order, id:`${item.collection}/${item.id}`, title:item.data.shortTitle || item.data.title,
    description:item.data.summary || item.data.domains?.join(' · ') || item.data.organization || '',
    date:item.data.dateDisplay || (item.data.dateStart ? String(item.data.dateStart.getFullYear()) : 'Date not recorded'),
    href:`/${item.collection}/${item.id}/`, category:categoryNames[item.collection] || item.collection};
}).sort((a,b)=>a.order-b.order || a.id.localeCompare(b.id));
const journey = datedJourney.map(({order,...record})=>record);
import { SITE_METADATA } from "../consts";
---

<Layout
  title={SITE_METADATA.home.title}
  description={SITE_METADATA.home.description}
  mode="explore"
>
  <main class="studio-page">
    <section
      class="studio-hero"
      id="studio"
      aria-label="Faizan Manshad's engineering studio"
    >
      <div class="studio-sheet-meta">
        <span>PORTFOLIO / FAIZAN MANSHAD</span>
        <span>AN EXPLORATION OF THE BUILT WORLD</span>
      </div>
      <div class="studio-intro">
        <p class="studio-eyebrow">
          <span></span> CIVIL ENGINEERING
          <br />
          WITH A DIGITAL PERSPECTIVE
        </p>
        <div
          class="name-drawing"
          tabindex="0"
          aria-label="Faizan Manshad — hover to inspect the lettering"
        >
          <span class="dimension dimension-top" aria-hidden="true">
            IDENTITY / 01
          </span>
          <h1>
            FAIZAN
            <br />
            MANSHAD
          </h1>
          <div class="name-outline" aria-hidden="true">
            FAIZAN
            <br />
            MANSHAD
          </div>
          <span class="dimension dimension-bottom" aria-hidden="true">
            PHYSICAL ↔ DIGITAL
          </span>
        </div>
        <p class="studio-tagline">
          Civil engineering.
          <br />
          <span>Digital curiosity.</span>
        </p>
        <p class="studio-intro-copy">
          I work where structures, information,
          <br class="desktop-break" /> and emerging technology meet.
        </p>
        <a class="skip-model" href="#selected-work">Go straight to the work ↓</a>
      </div>
      <div class="studio-model">
        <span class="model-coordinate" aria-hidden="true">
          PERSPECTIVE / 01
        </span>
        <StudioScene journey={journey} client:visible>
          <div slot="fallback" class="studio-static">
            <img
              src="/images/observatory.svg"
              alt="Colorful observatory with a turquoise dome and canal"
            />
            <p class="label">STRUCTURES / CONSTRUCTION / RESEARCH</p>
          </div>
        </StudioScene>
      </div>
      <div class="studio-caption">
        <span>
          <i></i> THE STUDIO — ONE MODEL, MANY STORIES
        </span>
        <span>DRAG TO ROTATE · LIFT THE DOME · SAIL THE CANAL</span>
      </div>
      <span class="studio-model-note">
        The Curiosity Observatory. A little place to look closer, discover and play.
      </span>
    </section>

    

    <section class="selected-work" id="selected-work">
      <div class="section-heading">
        <div>
          <p class="section-kicker">01 / SELECTED PRACTICE</p>
          <h2>
            From the model.
            <br />
            <span>Into the real world.</span>
          </h2>
        </div>
        <a href="/work/" class="text-link">
          ALL EXPERIENCE ↗
        </a>
      </div>
      <div class="practice-grid">
        <a class="practice-card" href={`/experience/${openspace.id}/`}>
          <div class="practice-art capture-art" aria-hidden="true">
            <div class="capture-grid"></div>
            <div class="capture-ring ring-one"></div>
            <div class="capture-ring ring-two"></div>
            <div class="capture-cross"></div>
            <div class="capture-target">
              360°<span>SITE → INFORMATION</span>
            </div>
            <span class="drawing-caption">REALITY CAPTURE / PROGRESS</span>
          </div>
          <div class="practice-meta">
            <span>01 / DIGITAL CONSTRUCTION</span>
            <span>{openspace.data.dateDisplay}</span>
          </div>
          <h3>
            {openspace.data.shortTitle} <span>↗</span>
          </h3>
          <p>{openspace.data.summary}</p>
          <span class="practice-role">{openspace.data.role}</span>
        </a>
        <a class="practice-card" href={`/experience/${urbana.id}/`}>
          <div class="practice-art bridge-art" aria-hidden="true">
            <svg viewBox="0 0 600 330" fill="none">
              <path d="M70 240 210 140 530 180 390 280Z" fill="#252e2a" />
              <g stroke="#c6c1a7" stroke-width="3">
                <path d="M85 205 405 245 520 161 200 121Z M85 140 405 180 520 96 200 56Z M85 140V205 M405 180V245 M520 96V161 M200 56V121 M85 140 149 213 213 156 277 229 341 172 405 245 M200 56 264 129 328 72 392 145 456 88 520 161" />
              </g>
              <path d="m85 140 320 40" stroke="#e97939" stroke-width="5" />
              <g stroke="#888c7d" stroke-width="2">
                <path d="M149 148 264 64 M213 156 328 72 M277 164 392 80 M341 172 456 88" />
              </g>
              <circle cx="405" cy="180" r="7" fill="#e97939" />
            </svg>
            <span class="drawing-caption">MODULAR INFRASTRUCTURE / STUDY</span>
          </div>
          <div class="practice-meta">
            <span>02 / BIM & DETAILING</span>
            <span>{urbana.data.dateDisplay}</span>
          </div>
          <h3>
            {urbana.data.shortTitle} <span>↗</span>
          </h3>
          <p>{urbana.data.summary}</p>
          <span class="practice-role">{urbana.data.role}</span>
        </a>
      </div>
    </section>

    <section class="research-feature">
      <div class="research-copy">
        <p class="section-kicker">02 / EXPERIMENTAL THINKING</p>
        <h2>
          What if the model
          <br />
          could leave
          <br />
          <em>the screen?</em>
        </h2>
        <p>{ar.data.summary}</p>
        <a class="text-link" href={`/research/${ar.id}/`}>
          EXPLORE BIM TO AR ↗
        </a>
        <span class="research-status">FYP RESEARCH / SSRN PREPRINT</span>
      </div>
      <a
        href={`/research/${ar.id}/`}
        class="research-art"
        aria-label="Explore BIM to augmented reality research"
      >
        <div class="ar-frame">
          <span class="ar-scanline"></span>
          <div class="ar-building">
            <i></i>
            <i></i>
            <i></i>
            <i></i>
          </div>
          <span class="ar-label">
            MODEL PLACED
            <br />
            PHYSICAL + DIGITAL
          </span>
        </div>
        <span class="ar-coordinate">MARKER / GROUND PLANE / LOCATION</span>
      </a>
    </section>

    <section class="project-register explorations-portal" id="further-explorations">
      <div class="section-heading">
        <div>
          <p class="section-kicker">03 / THE SYSTEM DIRECTORY</p>
          <h2>Further explorations.</h2>
          <p class="section-subtitle">
            Curated archives spanning academic projects, scholarly research, peer recognition, and personal perspective.
          </p>
        </div>
        <div class="directory-quick-nav">
          <a href="/projects/">PROJECTS ↗</a>
          <a href="/research/">RESEARCH ↗</a>
          <a href="/recognition/">RECOGNITION ↗</a>
          <a href="/about/">ABOUT ↗</a>
        </div>
      </div>

      <!-- 04.1 Academic & Engineering Projects -->
      <div class="directory-cluster">
        <div class="cluster-header">
          <div class="cluster-title-wrap">
            <span class="cluster-num">03.1</span>
            <div>
              <h3>Academic & Engineering Projects</h3>
