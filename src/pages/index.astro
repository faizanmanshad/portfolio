    inset: 0 -12px;
    border-top: 1px solid #ddd9c526;
    border-bottom: 1px solid #ddd9c526;
    pointer-events: none;
  }
  .name-drawing::after {
    inset: -10px 0;
    border: 0;
    border-left: 1px solid #ddd9c526;
    border-right: 1px solid #ddd9c526;
  }
  .dimension {
    position: absolute;
    font: 7px var(--font-mono);
    letter-spacing: 0.1em;
    color: #7d8578;
  }
  .dimension-top {
    top: -14px;
    right: 10px;
  }
  .dimension-bottom {
    bottom: -14px;
    left: 8px;
  }
  .name-outline {
    position: absolute;
    inset: 10px 5px;
    color: transparent;
    -webkit-text-stroke: 1px #f08b49;
    pointer-events: none;
    background: #101412;
    mask-image: radial-gradient(
      circle 65px at var(--inspect-x) var(--inspect-y),
      #000 75%,
      transparent 100%
    );
    opacity: 0;
  }
  .name-drawing:hover .name-outline,
  .name-drawing:focus-visible .name-outline {
    opacity: 1;
  }
  .studio-tagline {
    font-size: clamp(20px, 2vw, 31px);
    letter-spacing: -0.045em;
    line-height: 1.25;
    margin-top: 35px;
    margin-bottom: 15px;
  }
  .studio-tagline span {
    color: #b4b3a5;
  }
  .studio-intro-copy {
    color: #9fa294;
    font-size: 12px;
    line-height: 1.8;
    margin-bottom: 25px;
  }
  .explore-model {
    border: 1px solid #acae9466;
    background: #e0d6bd08;
    color: #e9e3d5;
    padding: 16px 20px;
    display: flex;
    gap: 35px;
    align-items: center;
    font: 9px var(--font-mono);
    letter-spacing: 0.08em;
