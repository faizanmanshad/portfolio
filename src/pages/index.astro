  }
  .studio-static {
    height: 100%;
    display: grid;
    place-items: center;
  }
  .studio-static img {
    width: 100%;
  }
  .studio-static p {
    color: #aab29e;
  }
    .selected-work,
  .project-register,
  .explorations-portal,
  .studio-footer {
    padding: 60px 5%;
    max-width: 1600px;
    margin: auto;
  }
  .section-kicker {
    font: 9px var(--font-mono);
    color: #9ba48f;
    letter-spacing: 0.12em;
    margin-bottom: 30px;
  }
  
  .principle-grid p {
    max-width: 260px;
    font-size: 12px;
    color: #939d8e;
    line-height: 1.8;
  }
  .selected-work {
    padding-top: 90px;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 45px;
    gap: 30px;
  }
  .section-heading h2 {
    font-size: clamp(30px, 4vw, 58px);
    letter-spacing: -0.045em;
  }
  .section-heading h2 span {
    color: #8b9586;
  }
  .text-link {
    font: 10px var(--font-mono);
    padding-bottom: 14px;
    border-bottom: 1px solid #aaa58a55;
    white-space: nowrap;
  }
  .practice-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
