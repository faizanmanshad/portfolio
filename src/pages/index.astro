            </div>
          </div>
          <a class="cluster-link" href="/projects/">All {projects.length} projects ↗</a>
        </div>
        <div class="cluster-grid project-cards-grid">
          {projects.slice(0, 4).map((item, i) => (
            <a class="directory-card" href={`/projects/${item.id}/`}>
              <div class="card-top">
                <span class="card-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="card-year">{item.data.dateDisplay || '2024'}</span>
              </div>
              <h4>{item.data.shortTitle || item.data.title}</h4>
              <p class="card-desc">{item.data.summary || item.data.deck}</p>
              <div class="card-footer">
                <span class="card-domain">{item.data.domains?.slice(0, 2).join(" · ")}</span>
                <span class="card-arrow">↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- 04.2 Scholarly Research -->
      <div class="directory-cluster">
        <div class="cluster-header">
          <div class="cluster-title-wrap">
            <span class="cluster-num">03.2</span>
            <div>
              <h3>Scholarly Research</h3>
              <p class="cluster-meta">Applied inquiry into augmented reality, BIM workflows & sustainable materials</p>
            </div>
          </div>
          <a class="cluster-link" href="/research/">Research archive ↗</a>
        </div>
        <div class="cluster-grid research-cards-grid">
          {research.map((item) => (
            <a class="directory-card directory-card--wide" href={`/research/${item.id}/`}>
              <div class="card-top">
                <span class="card-badge">PEER-REVIEWED / PREPRINT</span>
                <span class="card-year">{item.data.dateDisplay}</span>
              </div>
              <h4>{item.data.title}</h4>
              <p class="card-desc">{item.data.summary}</p>
              <div class="card-footer">
                <span class="card-domain">{item.data.role} · SSRN Preprint</span>
                <span class="card-arrow">↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- 04.3 Honors & Distinctions -->
      <div class="directory-cluster">
        <div class="cluster-header">
          <div class="cluster-title-wrap">
            <span class="cluster-num">03.3</span>
            <div>
              <h3>Honors & Distinctions</h3>
              <p class="cluster-meta">National competitions, department gold medal & academic accolades</p>
            </div>
          </div>
          <a class="cluster-link" href="/recognition/">Full record ({recognition.length}) ↗</a>
        </div>
        <div class="cluster-grid recognition-cards-grid">
          {recognition.slice(0, 4).map((item) => (
            <a class="directory-card" href={`/recognition/${item.id}/`}>
              <div class="card-top">
                <span class="card-award-tag">{item.data.dateDisplay || '2024'}</span>
                <span class="card-org">{item.data.organization?.split('·')[0]}</span>
              </div>
              <h4>{item.data.shortTitle || item.data.title}</h4>
              <p class="card-desc">{item.data.summary}</p>
              <div class="card-footer">
                <span class="card-domain">{item.data.domains?.join(" · ") || 'Distinction'}</span>
                <span class="card-arrow">↗</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- 04.4 About & Personal Perspective -->
      <div class="directory-cluster directory-cluster--about">
        <div class="cluster-header">
          <div class="cluster-title-wrap">
            <span class="cluster-num">03.4</span>
            <div>
              <h3>About & Perspective</h3>
              <p class="cluster-meta">Civil engineering foundations, community service & digital exploration</p>
            </div>
          </div>
          <a class="cluster-link" href="/about/">More about me ↗</a>
        </div>
        <div class="about-feature-card">
          <div class="about-card-body">
            <p class="about-eyebrow">BIOGRAPHY & DIGITAL PRACTICE</p>
            <h4>
              Connecting structural discipline with spatial computing.
            </h4>
            <p class="about-text">
              Faizan Manshad is a civil engineer whose work bridges structural analysis, Building Information Modelling (BIM), and augmented reality. Graduating with highest distinction from the Department of Civil Engineering, his practice is rooted in rigorous engineering standards paired with modern computational tools.
            </p>
            <div class="about-links">
              <a href="/about/" class="primary-pill">Read full background ↗</a>
              <a href="/contact/" class="secondary-link">Get in touch ↗</a>
              <a href="/academic/" class="secondary-link">Formal Academic Dossier ↗</a>
            </div>
          </div>
          <div class="about-highlights-grid">
            <div class="highlight-item">
              <span class="hl-number">01</span>
              <h5>Department Gold Medalist</h5>
              <p>Top rank in graduating Civil Engineering cohort with sustained academic excellence.</p>
            </div>
            <div class="highlight-item">
              <span class="hl-number">02</span>
              <h5>BIM & Digital Reality</h5>
              <p>Practical model authoring, 4D scheduling, reality capture and on-site AR alignment.</p>
            </div>
            <div class="highlight-item">
              <span class="hl-number">03</span>
              <h5>Community & Service</h5>
              <p>Active volunteer with Al-Khidmat and leadership in collegiate engineering societies.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="studio-footer">
      <p class="section-kicker">PEOPLE. STRUCTURES. POSSIBILITIES.</p>
      <h2>
        Always curious.
        <br />
        <span>Always building.</span>
      </h2>
      <div>
        <a href="/about/">THE PERSON BEHIND THE WORK ↗</a>
        <a href="/contact/">LET'S CONNECT ↗</a>
        <a href="/academic/">ACADEMIC CV ↗</a>
      </div>
      <p class="footer-colophon">
        FAIZAN MANSHAD <span>CIVIL ENGINEERING / BIM / RESEARCH</span>
      </p>
    </footer>
  </main>
</Layout>
<script>
  const drawing = document.querySelector<HTMLElement>(".name-drawing");
  drawing?.addEventListener("pointermove", (event) => {
    const rect = drawing.getBoundingClientRect();
    drawing.style.setProperty("--inspect-x", `${event.clientX - rect.left}px`);
    drawing.style.setProperty("--inspect-y", `${event.clientY - rect.top}px`);
  });
  
</script>
<style>
  :global(body:has(.studio-page) #custom-cursor) {
    display: none;
  }
  @keyframes studio-enter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .studio-page {
    --studio-muted: #9c9e92;
    background: #101412;
  }
  .studio-page :global(button),
  .studio-page :global(a) {
    -webkit-tap-highlight-color: transparent;
  }
  .studio-hero {
    max-width: 1800px;
    margin: auto;
    position: relative;
    min-height: 790px;
    height: min(940px, 100svh);
    padding: 120px 5% 100px;
    display: grid;
    grid-template-columns: 37% 63%;
    isolation: isolate;
    overflow: clip;
    background: radial-gradient(ellipse at 70% 45%, #33372c42, transparent 65%);
  }
  .studio-sheet-meta {
    position: absolute;
    top: 86px;
