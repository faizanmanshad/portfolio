---
import Layout from "../layouts/Layout.astro";
import StudioScene from "../components/studio/StudioScene";
import { getCollection } from "astro:content";
const experience = (await getCollection("experience")).sort(
  (a, b) => a.data.priority - b.data.priority,
);
const projects = (await getCollection("projects")).sort(
  (a, b) => a.data.priority - b.data.priority,
);
const research = await getCollection("research");
const recognition = (await getCollection("recognition")).sort(
  (a, b) => (a.data.priority ?? 99) - (b.data.priority ?? 99),
);
const urbana = experience.find((item) => item.id === "urbana")!;
const openspace = experience.find((item) => item.id === "openspace")!;
const ar = research.find((item) => item.id === "bim-to-ar")!;
// Build the guided visit from the same public records used by the archives.
const journeyCollections = await Promise.all([
  getCollection("education"),
  getCollection("recognition"),
  getCollection("journey"),
  getCollection("experience"),
  getCollection("projects"),
  getCollection("research"),
]);
const categoryNames: Record<string, string> = {
  education: "Education",
  recognition: "Recognition",
  journey: "Community",
  experience: "Professional Experience",
  projects: "Projects",
  research: "Research",
};
// Curated highlights only. Add an ID here when a new major milestone is ready.
const majorMilestoneIds = new Set([
  "education/bs-civil-engineering",
  "projects/rcd-school-building-design",
  "research/bim-to-ar",
  "recognition/gold-medalist",
  "experience/urbana",
  "experience/openspace",
]);
const datedJourney = journeyCollections
  .flat()
  .filter((item) => majorMilestoneIds.has(`${item.collection}/${item.id}`))
  .map((item) => {
    const year = item.data.dateDisplay?.match(/(?:19|20)\d{2}/)?.[0];
    const order =
      item.data.dateStart?.getTime() ??
      (year ? Date.UTC(Number(year), 0, 1) : Infinity);
    return {
      order,
      id: `${item.collection}/${item.id}`,
      title: item.data.shortTitle || item.data.title,
      description:
        item.data.summary ||
        item.data.domains?.join(" · ") ||
        item.data.organization ||
        "",
      date:
        item.data.dateDisplay ||
        (item.data.dateStart
          ? String(item.data.dateStart.getFullYear())
          : "Date not recorded"),
      href: `/${item.collection}/${item.id}/`,
      category: categoryNames[item.collection] || item.collection,
    };
  })
  .sort((a, b) => a.order - b.order || a.id.localeCompare(b.id));
const journey = datedJourney.map(({ order, ...record }) => record);
import { SITE_METADATA } from "../consts";
