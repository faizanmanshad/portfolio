      </section>
      <footer class="academic-end" data-academic-reveal>
        <p class="eyebrow">CONTINUE THE CONVERSATION</p>
        <h2>
          Ideas become stronger
          <br />
          when shared.
        </h2>
        <a href="/contact/">Let’s connect ↗</a>
