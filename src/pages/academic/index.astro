        </section>
      ))}

      <section id="languages" data-academic-section>
        <div class="section-top">
          <h2>
            <span>{sectionNumbers.get("languages")} /</span> Languages
          </h2>
          <span class="section-badge">Bilingual Competence</span>
        </div>
        <div class="languages-grid" data-academic-reveal>
          <div class="language-card">
            <div class="lang-header">
              <h3>Urdu</h3>
              <span class="lang-level">Native / Mother Tongue</span>
            </div>
            <p class="muted">
              Urdu is my first language. I speak, read and write it.
            </p>
            <div class="lang-tags">
              <span>Native Speaker</span>
            </div>
          </div>
          <div class="language-card">
            <div class="lang-header">
              <h3>English</h3>
              <span class="lang-level">Full Professional Proficiency (Fluent)</span>
            </div>
