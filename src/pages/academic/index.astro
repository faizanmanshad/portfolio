---
import { contactEmail, linkedInProfile } from "../../consts";
import Layout from "../../layouts/Layout.astro";
import AcademicShowMore from "../../components/AcademicShowMore.astro";
import { Image } from 'astro:assets';
import researchCover from '../../assets/research-cover.png';
import { getCollection } from "astro:content";
const sort = (items: any[]) =>
  items.sort((a, b) => (a.data.priority ?? 99) - (b.data.priority ?? 99));
const experience = sort(await getCollection("experience"));
const projects = sort(await getCollection("projects"));
const recognition = sort(await getCollection("recognition"));
const journey = sort(await getCollection("journey"));
const research = sort(await getCollection("research"));
const education = sort(await getCollection("education"));
const development = sort(await getCollection("development"));

const certifications = development
  .filter((item: any) => item.data.type === "Certification")
  .sort((a: any, b: any) => new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime());
const professionalTraining = development.filter((item: any) => item.data.type === "Professional Training");
const conferences = journey.filter((item: any) => item.data.type === "Conference" || item.id === "uw-pofs-joint-conference");
const extracurriculars = journey.filter((item: any) => item.data.type !== "Community Service" && item.data.type !== "Conference" && item.id !== "uw-pofs-joint-conference");
const volunteering = journey.filter((item: any) => item.data.type === "Community Service");

const sectionItems = [
  { id: "personal-information", name: "Personal Information" },
  { id: "education", name: "Education" },
  { id: "research", name: "Research" },
  { id: "practice", name: "Experience" },
  { id: "projects", name: "Academic Projects" },
  { id: "certifications", name: "Certifications" },
  { id: "training", name: "Professional Training" },
  { id: "conferences", name: "Conferences" },
  { id: "recognition", name: "Honors & Awards" },
  { id: "skills", name: "Skills" },
  { id: "extracurriculars", name: "Extracurriculars" },
  { id: "volunteering", name: "Volunteering" },
  { id: "languages", name: "Languages" },
];
const sectionNumbers = new Map(sectionItems.map(({ id }, i) => [id, String(i + 1).padStart(2, "0")]));
const groupsUpper = [
  {
    id: "practice",
    title: "Professional Experience",
    link: "/work/",
    label: "All experience",
    items: experience,
  },
  {
    id: "projects",
    title: "Academic Projects",
    link: "/projects/",
    label: "All academic projects",
    items: projects,
  },
  {
    id: "certifications",
    title: "Certifications",
    link: "/academic/#certifications",
    label: `${certifications.length} verified credentials`,
    items: certifications,
  },
  {
    id: "training",
    title: "Professional Training & CPD",
    link: "/academic/#training",
    label: "PEC CPD & technical workshops",
    items: professionalTraining,
  },
  {
    id: "conferences",
    title: "Conferences",
    link: "/academic/#conferences",
    label: "Academic & industry events",
    items: conferences,
  },
  {
    id: "recognition",
    title: "Honors & Awards",
    link: "/recognition/",
    label: "Full recognition record",
    items: recognition,
  },
];
const groupsLower = [
  {
    id: "extracurriculars",
    title: "Extracurricular Activities",
    link: "/about/",
    label: "More about me",
    items: extracurriculars,
  },
  {
    id: "volunteering",
    title: "Volunteering & Community Services",
    link: "/about/",
    label: "More about me",
    items: volunteering,
  },
];
import { SITE_METADATA } from "../../consts";
---

<Layout
  title={SITE_METADATA.academic.title}
  description={SITE_METADATA.academic.description}
>
  <main class="dossier">
    <aside class="dossier-index" aria-label="Academic sections">
      <div class="mobile-section-picker">
        <label for="academic-section">SECTIONS</label>
        <select id="academic-section">
          {sectionItems.map((sec) => <option value={sec.id}>{sectionNumbers.get(sec.id)} / {sec.name}</option>)}
        </select>
      </div>
      <p class="eyebrow">ON THIS PAGE</p>
      <nav>
        {sectionItems.map((sec) => (
          <a href={`#${sec.id}`} data-section-link>
            <span>{sectionNumbers.get(sec.id)}</span>
            {sec.name}
          </a>
        ))}
      </nav>
      <p class="index-note">
        CIVIL ENGINEERING
        <br />
        WITH A DIGITAL
        <br />
        PERSPECTIVE.
      </p>
    </aside>
    <div class="dossier-content">
      <header id="profile" class="profile">
        <div>
          <p class="eyebrow">ACADEMIC PROFILE / FAIZAN MANSHAD</p>
          <h1>
            Faizan Manshad<span>.</span>
          </h1>
          <p class="profile-deck">
            Civil engineering and building information modelling
          </p>
          <p class="muted intro">
            I draft pedestrian bridges in Revit and review site photos to track construction progress. For my final year project, our team tested ways to view a building layout in augmented reality.
          </p>
          <div class="profile-actions">
            <a class="primary-action" href="/contact/">
              Get in touch <span>↗</span>
            </a>
            <a href="/about/">About me ↗</a>
          </div>
        </div>
        <figure class="profile-drawing">
          <img
            src="/images/studio-fallback.svg"
            alt="Illustrative architectural model of a pavilion and bridge"
          />
          <figcaption>STRUCTURES / INFORMATION / IDEAS</figcaption>
        </figure>
      </header>
      <section id="personal-information" class="personal-info" data-academic-section aria-labelledby="personal-info-title">
        <div class="section-top">
          <h2 id="personal-info-title"><span>{sectionNumbers.get("personal-information")} /</span> Personal Information</h2>
        </div>
        <dl>
          <div><dt>Location</dt><dd>Taxila, Pakistan</dd></div>
          <div><dt>Direct email</dt><dd><a href={`mailto:${contactEmail}`}>{contactEmail}</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href={linkedInProfile}>linkedin.com/in/faizanmanshad ↗</a></dd></div>
        </dl>
        <p class="personal-summary">
          I’m a civil engineering graduate with an interest in how structures are designed, drawn and built.
          My work in building information modelling has made me curious about how engineering teams use drawings and models on site.
          Through further study and practice, I want to develop that understanding and bring it into the projects I work on.
        </p>
      </section>
      <section id="education" data-academic-section>
        <div class="section-top">
          <h2>
            <span>{sectionNumbers.get("education")} /</span> Education
          </h2>
        </div>
        <div class="record-list" id="education-records" data-academic-items>
          {education.map((item) => (
            <a
              class="dossier-record"
              data-academic-reveal
              href={`/education/${item.id}/`}
            >
              <span class="record-date">{item.data.dateDisplay}</span>
              <div>
                <h3>{item.data.shortTitle || item.data.title}</h3>
                <p class="muted">{item.data.organization}</p>
              </div>
              <span class="record-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <AcademicShowMore listId="education-records" total={education.length} label="education entries" />
        <div class="interests" data-academic-reveal>
          <p class="eyebrow">AREAS OF INTEREST</p>
          <p>
            BIM workflows <span> / </span> Digital construction <span> / </span>{" "}
            Augmented reality
          </p>
        </div>
      </section>
      <section id="research" data-academic-section>
        <div class="section-top">
          <h2>
            <span>{sectionNumbers.get("research")} /</span> Research & experimentation
          </h2>
          <a href="/research/">Research archive ↗</a>
        </div>
        <div id="research-records" data-academic-items>
        {research.map((item) => (
          <article class="research-feature" data-academic-reveal>
            <a
              href={`/research/${item.id}/`}
              class="research-visual"
              aria-label="Read BIM to AR research"
            >
              <Image class="manuscript-preview" src={researchCover} width={900} format="webp" loading="lazy" alt="Illustration inspired by the research: a BIM structure connected to marker-based, ground-plane and location-based augmented reality" />
              <span class="manuscript-caption">RESEARCH OVERVIEW / AI-ASSISTED ILLUSTRATION</span>
            </a>
            <div>
              <p class="eyebrow accent">
                SSRN PREPRINT / {item.data.dateDisplay}
              </p>
              <h3>
                <a href={`/research/${item.id}/`}>BIM to Augmented Reality</a>
              </h3>
              <p class="muted">{item.data.summary}</p>
              <p class="research-role">{item.data.role} · Final Year Project</p>
              <div class="research-actions">
                <a href={`/research/${item.id}/`}>Read study ↗</a>
                {item.data.links?.map(
                  (link: { url: string; label: string }) => (
                    <a href={link.url} target="_blank" rel="noreferrer">
                      View preprint ↗
                    </a>
                  ),
                )}
              </div>
            </div>
          </article>
        ))}
        </div>
        <AcademicShowMore listId="research-records" total={research.length} label="research entries" />
      </section>
      {groupsUpper.map((group) => (
        <section id={group.id} data-academic-section>
          <div class="section-top">
            <h2>
              <span>{sectionNumbers.get(group.id)} /</span> {group.title}
            </h2>
            <a href={group.link}>{group.label} ↗</a>
          </div>
          <div id={`${group.id}-records`} data-academic-items class={`record-list ${group.id === 'extracurriculars' || group.id === 'projects' || group.id === 'certifications' || group.id === 'training' ? 'grid-list' : ''}`}>
            {group.items.map((item: any) => (
              <a
                class="dossier-record"
                data-academic-reveal
                href={`/${item.collection}/${item.id}/`}
              >
                <span class="record-date">{item.data.dateDisplay}</span>
                <div>
                  <h3>
                    {item.data.organization && group.id === "practice"
                      ? item.data.organization
                      : item.data.shortTitle || item.data.title}
                  </h3>
                  <p class="muted">
                    {group.id === "practice"
                      ? `${item.data.role}. ${item.data.summary || ""}`
                      : group.id === "certifications"
                      ? `${item.data.organization ? item.data.organization + ' · ' : ''}${item.data.summary || ''}`
                      : group.id === "training"
                      ? item.data.summary || item.data.domains?.join(" / ") || ''
                      : item.data.summary ||
                        item.data.domains?.join(" / ") ||
                        item.data.type}
                  </p>
                </div>
                <span class="record-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
            ))}
          </div>
          <AcademicShowMore listId={`${group.id}-records`} total={group.items.length} label={group.title} />
        </section>
      ))}

      <!-- 09 / Skills -->
      <section id="skills" data-academic-section>
        <div class="section-top">
          <h2>
            <span>{sectionNumbers.get("skills")} /</span> Skills
          </h2>
          <span class="section-badge">Core Competencies & Toolset</span>
        </div>
        <p class="skills-deck">
          Core civil engineering competencies, specialized modeling software, and professional soft skills.
        </p>
        <div class="skills-grid" data-academic-reveal>
          <div class="skill-category-card">
            <div class="skill-cat-header">
              <span class="skill-cat-eyebrow">STRUCTURAL & CONSTRUCTION</span>
              <h3>Core Competencies</h3>
            </div>
            <ul class="skill-list">
              <li>
                <span class="skill-icon">+</span>
                <span>Structural Analysis & Design <small>(ETABS · SAFE · RISA-2D)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Reinforced Concrete Design <small>(ACI 318 · UBC 97 · BCP)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>High-Rise Structural Modeling & Lateral Load Analysis</span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Foundation Design & Soil Mechanics <small>(Mat & Footings)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Modular Steel Bridge Detailing & Structural Framing</span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Reinforcement Detailing & Bar Bending Schedules <small>(BBS)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Construction Scheduling & Critical Path Method <small>(Primavera P6)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Quantity Surveying, BOQ & Material Takeoff</span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>On-Site QA/QC, Rebar Inspection & Formwork Verification</span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Site Leveling, Benchmarking & Grid Setting-Out</span>
              </li>
            </ul>
          </div>

          <div class="skill-category-card">
            <div class="skill-cat-header">
              <span class="skill-cat-eyebrow">BIM & COMPUTATION</span>
              <h3>Software & Tools</h3>
            </div>
            <ul class="skill-list">
              <li>
                <span class="skill-icon">+</span>
                <span>Autodesk Revit <small>(Structure, Architecture & MEP · LOD 200–350)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>CSI ETABS <small>(3D Dynamic Analysis & Seismic Design)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>CSI SAFE <small>(Slab, Foundation & Mat Design)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>RISA-2D <small>(Planar Frame & Truss Finite Element Modeling)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>AutoCAD 2D <small>(Engineering Drafting & Construction Detailing)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Primavera P6 <small>(Construction Project Scheduling & Planning)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>OpenSpace <small>(360° Reality Capture & Progress Tracking)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Multimodal Augmented Reality <small>(BIM-to-AR Ground Plane & Marker)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Microsoft Excel <small>(Parametric Structural Calculation Spreadsheets)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>GIS & Remote Sensing Foundations <small>(ArcGIS)</small></span>
              </li>
            </ul>
          </div>

          <div class="skill-category-card">
            <div class="skill-cat-header">
              <span class="skill-cat-eyebrow">LEADERSHIP & COLLABORATION</span>
              <h3>Soft Skills</h3>
            </div>
            <ul class="skill-list">
              <li>
                <span class="skill-icon">+</span>
                <span>Cross-Disciplinary Coordination <small>(BIM · Structural · MEP · Site)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Technical Research & Academic Paper Writing</span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Public Speaking & Conference Presentations</span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Critical Thinking & Analytical Problem-Solving</span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Team Leadership & Fellowship Mentorship <small>(OMLAS · ASPIRE)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Project Stakeholder & Field Team Communication</span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Community Service Organization <small>(Al-Khidmat Foundation)</small></span>
              </li>
              <li>
                <span class="skill-icon">+</span>
                <span>Self-Directed Learning & Emerging Tech Exploration</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      {groupsLower.map((group) => (
        <section id={group.id} data-academic-section>
          <div class="section-top">
            <h2>
              <span>{sectionNumbers.get(group.id)} /</span> {group.title}
            </h2>
            <a href={group.link}>{group.label} ↗</a>
          </div>
          <div id={`${group.id}-records`} data-academic-items class={`record-list ${group.id === 'extracurriculars' || group.id === 'projects' || group.id === 'certifications' || group.id === 'training' ? 'grid-list' : ''}`}>
            {group.items.map((item: any) => (
              <a
                class="dossier-record"
                data-academic-reveal
                href={`/${item.collection}/${item.id}/`}
              >
                <span class="record-date">{item.data.dateDisplay}</span>
                <div>
                  <h3>
                    {item.data.organization && group.id === "practice"
                      ? item.data.organization
                      : item.data.shortTitle || item.data.title}
                  </h3>
                  <p class="muted">
                    {group.id === "practice"
                      ? `${item.data.role}. ${item.data.summary || ""}`
                      : group.id === "certifications"
                      ? `${item.data.organization ? item.data.organization + ' · ' : ''}${item.data.summary || ''}`
                      : group.id === "training"
                      ? item.data.summary || item.data.domains?.join(" / ") || ''
                      : item.data.summary ||
                        item.data.domains?.join(" / ") ||
                        item.data.type}
                  </p>
                </div>
                <span class="record-arrow" aria-hidden="true">
                  ↗
