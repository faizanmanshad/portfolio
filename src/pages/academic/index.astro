</Layout>
<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)");
  const sections = [
    ...document.querySelectorAll<HTMLElement>("[data-academic-section]"),
  ];
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-section-link]"),
  ];
  let ticking = false;
  const sectionPicker = document.querySelector<HTMLSelectElement>("#academic-section");

  function scrollToSection(targetId: string, smooth = true) {
    const target = document.getElementById(targetId);
    if (!target) return;
    target.scrollIntoView({
      behavior: (reduced.matches || !smooth) ? "instant" : "smooth",
      block: "start",
    });
  }

  sectionPicker?.addEventListener("change", () => {
    const targetId = sectionPicker.value;
    if (!targetId) return;
    history.replaceState(history.state, "", `#${targetId}`);
    scrollToSection(targetId);
  });

  links.forEach((link) => {
    link.addEventListener("click", (event) => {
      const href = link.getAttribute("href");
      if (!href || !href.startsWith("#")) return;
      const targetId = href.slice(1);
      const target = document.getElementById(targetId);
      if (!target) return;
      event.preventDefault();
      history.pushState(null, "", href);
      scrollToSection(targetId);
      links.forEach((l) => l.removeAttribute("aria-current"));
      link.setAttribute("aria-current", "location");
      if (sectionPicker) sectionPicker.value = targetId;
    });
  });

  function updateIndex() {
    let active = sections[0]?.id;
    sections.forEach((section) => {
      if (section.getBoundingClientRect().top <= 180) active = section.id;
    });
    links.forEach((link) => {
      if (link.hash === `#${active}`)
        link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
    if (sectionPicker && active) sectionPicker.value = active;
    ticking = false;
  }
  addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateIndex);
      }
    },
    { passive: true },
  );
  updateIndex();
</script>
<style>
  [data-academic-items] > [hidden] { display: none !important; }
  .manuscript-preview { display:block; width:100%; height:100%; object-fit:contain; padding:12px 12px 35px; }
  .manuscript-caption { position:absolute; bottom:10px; left:12px; right:12px; text-align:center; font:8px var(--font-mono); color:#c2c8ba; }
  .mobile-section-picker { display: none; }
  .dossier {
    max-width: 1440px;
    margin: auto;
    padding: calc(var(--nav-h) + 24px) 5vw 60px;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 55px;
    color: #ede8e1;
  }
  .dossier-index {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    height: calc(100vh - var(--nav-h) - 48px);
    border-right: 1px solid #ffffff1c;
    padding-right: 24px;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    scrollbar-width: none;
  }
  .dossier-index::-webkit-scrollbar {
    display: none;
  }
  .eyebrow {
    font: 10px/1.7 var(--font-mono);
    letter-spacing: 0.1em;
    color: #a1a79e;
    flex-shrink: 0;
  }
  .dossier-index nav {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1 1 auto;
    min-height: min-content;
    max-height: clamp(415px, 63vh, 675px);
    margin-top: clamp(9.5px, 1.4vh, 16px);
    margin-bottom: clamp(11.5px, 1.6vh, 21px);
    gap: 4px;
  }
  .dossier-index a {
    font-size: 13px;
    padding: clamp(3.2px, 0.4vh, 5.2px) 0 clamp(3.2px, 0.4vh, 5.2px) 10px;
    border-left: 2px solid transparent;
    display: flex;
    gap: 14px;
    align-items: baseline;
    white-space: nowrap;
    transition: color 0.15s ease, border-color 0.15s ease;
